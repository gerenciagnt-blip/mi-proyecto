# =============================================================================
#  Sistema PILA — variables de entorno
# =============================================================================
# Copia este archivo a `.env` y completá los valores. Las marcadas con [DEV] son
# opcionales en local; las [PROD] son obligatorias para deploy a producción.

# -----------------------------------------------------------------------------
# Base de datos (Postgres) — [PROD] obligatorio
# -----------------------------------------------------------------------------
# En desarrollo apuntamos a la BD dev de Neon. En producción usá una conexión
# con pooling (la URL termina en `-pooler.us-east-1.aws.neon.tech`).
DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public&sslmode=require"

# -----------------------------------------------------------------------------
# NextAuth v5 (Auth.js) — [PROD] obligatorio
# -----------------------------------------------------------------------------
# AUTH_SECRET: generar con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambiar-en-produccion-minimo-32-bytes-base64"
# AUTH_URL es la URL pública del sitio (incluí https en prod).
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL: alias usado por algunas integraciones legacy. Deja el mismo
# valor que AUTH_URL para evitar inconsistencias.
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# PagoSimple — integración API PILA — [PROD] obligatorio si se usa
# -----------------------------------------------------------------------------
# Si todas estas vars están vacías, el módulo PagoSimple queda deshabilitado y
# las planillas no se pueden subir al operador.
PAGOSIMPLE_BASE_URL="https://api.pagosimple.com"
# Aportante MASTER (la empresa operadora que se autentica contra PagoSimple).
PAGOSIMPLE_MASTER_NIT=""
PAGOSIMPLE_MASTER_COMPANY=""
PAGOSIMPLE_MASTER_SECRET_KEY=""
PAGOSIMPLE_MASTER_DOCUMENT_TYPE="CC"
PAGOSIMPLE_MASTER_DOCUMENT=""
PAGOSIMPLE_MASTER_PASSWORD=""
# TTL del token cacheado (default 30 min). El operador NO documenta el TTL
# real del token; el código tiene auto-refresh on 401 (withAuthRetry), así
# que valores 30-60 son seguros. Bajalo si PagoSimple empieza a devolver
# 401 muy seguido (cada call pagaría ~400 ms de re-login).
PAGOSIMPLE_TOKEN_TTL_MIN="30"

# -----------------------------------------------------------------------------
# Efipay — pasarela de cobros aliados — [PROD] obligatorio si se usa
# -----------------------------------------------------------------------------
# Host real (NO api.efipay.co — ese dominio no existe).
EFIPAY_BASE_URL="https://sag.efipay.co"
EFIPAY_ACCESS_TOKEN=""
EFIPAY_OFFICE_ID=""
# Token compartido para verificar la firma HMAC-SHA256 del webhook.
EFIPAY_WEBHOOK_TOKEN=""
# URL pública a la que Efipay envía el webhook (debe ser HTTPS, accesible
# desde Internet — ngrok en dev, dominio real en prod).
EFIPAY_WEBHOOK_URL="https://<dominio-publico>/api/efipay/webhook"
# Base donde el browser vuelve después de pagar (puede ser localhost en dev).
EFIPAY_RETURN_URL_BASE="http://localhost:3000"

# -----------------------------------------------------------------------------
# Cron externo — endpoints disparados por scheduler externo
# -----------------------------------------------------------------------------
# Si se setea, los endpoints /api/cron/* exigen `Authorization: Bearer <secret>`.
# Si queda vacío, los crones solo se aceptan desde localhost (dev).
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Notificaciones (Resend + WhatsApp) — [PROD] opcional, hoy en stub
# -----------------------------------------------------------------------------
# Sprint 4.4: cuando esté listo, completar para envío real de emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@<dominio>"
# Sprint 4.5: integración WhatsApp Business API.
WHATSAPP_TOKEN=""
# Destinatarios admin para PQRS (cuando llega un nuevo radicado).
PQRS_ADMIN_EMAIL=""
PQRS_ADMIN_WHATSAPP=""

# -----------------------------------------------------------------------------
# Almacenamiento de archivos subidos — [PROD] obligatorio
# -----------------------------------------------------------------------------
# Carpeta raíz donde se guardan adjuntos (incapacidades, cartera PDF,
# comprobantes Colpatria, etc.). DEBE ser ABSOLUTO si tienes web app y
# bot corriendo en distintos cwd — sin path absoluto, cada app resuelve
# `./uploads` relativo a su propio cwd y los archivos divergen.
# En local Windows: "C:/Users/<user>/mi-proyecto/uploads"
# En GH Actions / DO: ruta del volumen persistente montado.
UPLOADS_DIR="./uploads"

# -----------------------------------------------------------------------------
# Logging — [DEV] opcional
# -----------------------------------------------------------------------------
# Niveles válidos: trace | debug | info | warn | error | fatal | silent
# - dev:  "debug" (más verbose) o "info"
# - prod: "info" o "warn"
LOG_LEVEL="info"
# Formato del log: "json" (prod, estructurado) o "pretty" (dev, legible).
LOG_FORMAT="pretty"
# Prisma logging (queries lentas). Defaults razonables; subir umbrales si
# generan ruido.
SLOW_QUERY_WARN_MS="500"
SLOW_QUERY_CRITICAL_MS="2000"
# Si "true", instrumenta cada query Prisma con un span (más overhead, útil
# para debug puntual).
PILA_QUERY_PROBE="false"
# Si "true", logea en stdout cada query Prisma (muy verbose).
PRISMA_LOG="false"

# -----------------------------------------------------------------------------
# Sentry (monitoreo de errores) — [PROD] opcional pero recomendado
# -----------------------------------------------------------------------------
# Si las dos vars están vacías, el SDK queda en modo no-op (no se mandan
# eventos y no hay overhead). En producción, conseguir un DSN desde
# sentry.io → Settings → Projects → tu proyecto → Client Keys (DSN).
#
# IMPORTANTE: necesitás SETEAR LAS DOS con el mismo DSN. La diferencia:
#   - SENTRY_DSN se lee server-side (server actions, route handlers, bot,
#     cli, instrumentation.ts).
#   - NEXT_PUBLIC_SENTRY_DSN se inyecta en el bundle del browser para
#     capturar errores del cliente (componentes 'use client', event
#     handlers, fetch fallidos). Sin este prefijo, Next no la expone al
#     bundle del cliente y los errores client-side se pierden.
#
# Para GH Actions: agregar SENTRY_DSN como secret. Los workflows del bot
# Colpatria lo leen automáticamente vía dotenv.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# -----------------------------------------------------------------------------
# Entorno — [DEV] opcional
# -----------------------------------------------------------------------------
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Backup automatizado a S3 (opcional pero recomendado en prod) — [PROD]
# -----------------------------------------------------------------------------
# Solo se usa por el GitHub Action `db-backup.yml`. Si no se configuran, el
# workflow falla con un mensaje claro y queda fuera el backup automatizado.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
BACKUP_S3_BUCKET=""
# Prefijo dentro del bucket: ej. "pila-prod" → s3://bucket/pila-prod/2026-04-25.dump
BACKUP_S3_PREFIX="pila-prod"

# -----------------------------------------------------------------------------
# Bot Colpatria ARL (Sprint 8) — [PROD] obligatorio si se usa el bot
# -----------------------------------------------------------------------------
# URL del portal de Colpatria ARL al que se loguea el bot.
COLPATRIA_BASE_URL=""
# Modo Playwright. true = sin UI (servidor), false = con UI (debug local).
COLPATRIA_HEADLESS="true"
# Slow-motion en ms entre acciones del bot (debug local). 0 = sin delay.
COLPATRIA_SLOWMO="0"
# Clave para encriptar credenciales (usuario/password) y cookies de sesión
# de cada empresa planilla. AES-256-GCM con scrypt KDF.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: si rotás esta key, los registros encriptados antes ya no se
# pueden descifrar. El operador tiene que reingresar las credenciales de
# cada empresa.
COLPATRIA_ENC_KEY=""
# Habilita la rama REACTIVAR del bot. Default: true.
# Cuando está en "false", todo job con evento=REACTIVAR se marca como
# FAILED no-retryable (comportamiento previo a Sprint 8 REACTIVAR).
# Útil para revertir sin redeploy si surge un problema en producción.
COLPATRIA_REACTIVAR_ENABLED="true"
