// Sistema PILA — esquema base
// Multi-tenant por Sucursal (cada aliado = una sucursal).
// Empresas son globales (admin-gestionadas), accesibles por usuarios vía UsuarioEmpresa.

generator client {
  provider = "prisma-client-js"
  // Custom output dentro del package — Prisma 6 + pnpm + Next 15 + Windows
  // tienen un bug donde el cliente generado en el path default
  // (`node_modules/.pnpm/@prisma+client@.../node_modules/.prisma/client/`)
  // pierde la referencia al `query_engine-windows.dll.node` cuando Webpack
  // lo bundlea (el `__dirname` se vuelve relativo al bundle, no a la
  // ubicación real). Con `output` custom el cliente y el `.dll` viven
  // juntos en `packages/db/src/generated/client/` y el resolver de Prisma
  // los encuentra siempre.
  // Importar desde `@pila/db` (re-export en src/index.ts) — nunca desde
  // `@prisma/client` directamente.
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Roles del sistema ---
// Niveles base — cada usuario tiene uno. Para refinar permisos dentro
// de un nivel, se le asigna además un `RolCustom` con su propia matriz
// de permisos.
enum Role {
  ADMIN // staff plataforma — ve todo, sin sucursal
  SOPORTE // staff plataforma — mismos permisos base que ADMIN pero con matriz configurable
  ALIADO_OWNER // dueño del aliado — ve toda su sucursal
  ALIADO_USER // sub-usuario del aliado — depende del ALIADO_OWNER, permisos refinados con RolCustom
  // Asesor comercial con login. Pertenece a una sucursal (la del aliado)
  // y queda amarrado al registro del catálogo `AsesorComercial` vía
  // User.asesorComercialId — así heredamos código, comisiones y datos
  // del catálogo histórico sin duplicar. El scope filtra todo el dominio
  // (Afiliaciones, Cartera, Dashboard) por `asesorComercialId = el suyo`.
  ASESOR_COMERCIAL
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum TipoDocumento {
  CC
  CE
  NIT
  PAS
  TI
  RC
  NIP
}

enum NivelRiesgo {
  I
  II
  III
  IV
  V
}

enum TipoEntidadSgss {
  EPS
  AFP
  ARL
  CCF
}

enum Genero {
  M
  F
  O // Otro
}

enum EstadoAfiliacion {
  ACTIVA
  INACTIVA
}

enum Regimen {
  ORDINARIO
  RESOLUCION
}

// Modalidad de afiliación — discrimina el flujo de independientes vs dependientes.
// Se guarda tanto en el catálogo (TipoCotizante) como en la afiliación para
// filtrado rápido y reglas de validación específicas por rama.
enum Modalidad {
  DEPENDIENTE
  INDEPENDIENTE
}

// Forma de pago — aplica sólo a INDEPENDIENTE.
// VIGENTE  = paga por adelantado (cubre el mismo mes en que cotiza)
// VENCIDO  = paga el mes siguiente (cubre el mes anterior)
enum FormaPago {
  VIGENTE
  VENCIDO
}

// Bitácora transversal — registra cambios sobre entidades del sistema.
// Patrón simple: guardamos antes/después como JSON para auditoría.
//
// Visibilidad (Sprint 6):
//   - STAFF (ADMIN/SOPORTE) → todo
//   - ALIADO_OWNER → solo eventos donde userSucursalId = su sucursal
//                    O entidadSucursalId = su sucursal
//   - ALIADO_USER → sin acceso
//
// Retención: cron mensual purga filas con createdAt > 12 meses (Sprint 6.6).
model AuditLog {
  id          String   @id @default(cuid())
  entidad     String // ej. "Afiliacion"
  entidadId   String
  accion      String // "CREAR" | "EDITAR" | "ELIMINAR" | "TOGGLE" — string libre
  userId      String?
  userName    String?
  descripcion String?
  cambios     Json? // { antes: {...}, despues: {...}, campos: [...] }
  createdAt   DateTime @default(now())

  // ----- Campos añadidos en Sprint 6 (todos nullable para compat con eventos previos) -----
  /**
   * /**
   * /**
   * /**
   * /** Snapshot del rol del usuario al momento del evento.
   */
  userRole          Role?
  /**
   * Sucursal del usuario al momento del evento. Null si era staff sin sucursal.
   */
  userSucursalId    String?
  /**
   * Sucursal a la que pertenece la entidad al momento del evento. Null si
   * la entidad es global (catálogos, asesores globales, empresas planilla).
   */
  entidadSucursalId String?
  /**
   * IP del cliente para auditoría legal. Best-effort.
   */
  ip                String?

  user            User?     @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  userSucursal    Sucursal? @relation("AuditActorSucursal", fields: [userSucursalId], references: [id], onDelete: SetNull)
  entidadSucursal Sucursal? @relation("AuditEntidadSucursal", fields: [entidadSucursalId], references: [id], onDelete: SetNull)

  @@index([entidad, entidadId])
  @@index([userId, createdAt])
  @@index([userSucursalId, createdAt])
  @@index([entidadSucursalId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Bitácora de intentos de login — usada por el rate-limit de 3 fallos
// en 10 min. Se consulta filtrando por email y createdAt > ahora-10min.
// `success` permite diferenciar intentos exitosos y correctos (para
// limpiar contador) de los fallidos (que suman al bloqueo).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String // normalizado a lowercase
  ip        String?
  userAgent String?
  success   Boolean  @default(false)
  motivo    String? // "password_wrong" | "user_inactive" | "unknown_email" | "rate_limited"
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// Permisos granulares: qué puede hacer cada rol en cada módulo.
// Presencia en la tabla = permitido. Ausencia = denegado.
// ADMIN implícitamente tiene todos los permisos (se saltea esta tabla).
model Permiso {
  role   Role
  modulo String // clave del módulo ej. "config.sucursales"
  accion String // "VER" | "CREAR" | "EDITAR" | "ELIMINAR"

  @@id([role, modulo, accion])
  @@map("permisos")
}

// Roles personalizados creados por el admin — variaciones con
// permisos específicos sobre un rol base (ALIADO_OWNER o SOPORTE).
// Ejemplos: "Operaciones", "Facturación", "Cartera" heredando de
// ALIADO_OWNER con permisos restringidos.
model RolCustom {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  basedOn     Role // ALIADO_OWNER o SOPORTE (ADMIN no se personaliza)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permisos PermisoCustom[]
  users    User[]

  @@map("roles_custom")
}

model PermisoCustom {
  rolCustomId String
  modulo      String
  accion      String

  rolCustom RolCustom @relation(fields: [rolCustomId], references: [id], onDelete: Cascade)

  @@id([rolCustomId, modulo, accion])
  @@map("permisos_custom")
}

// --- Sucursal = tenant (cada aliado tiene la suya) ---
model Sucursal {
  id               String   @id @default(cuid())
  codigo           String   @unique // ej. "ALI-001"
  nombre           String
  active           Boolean  @default(true)
  bloqueadaPorMora Boolean  @default(false) // si true, el aliado solo puede ver/pagar su CxC
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                User[]
  cuentasCobro         CuentaCobro[]
  comprobanteFormato   ComprobanteFormato?
  mediosPago           MedioPago[]
  asesoresComerciales  AsesorComercial[]
  serviciosAdicionales ServicioAdicional[]
  cotizantes           Cotizante[]
  planillas            Planilla[]
  carterasAsignadas    CarteraDetallado[]
  incapacidades        Incapacidad[]
  soportesAfiliacion   SoporteAfiliacion[]
  reportesAt           ReporteAccidenteTrabajo[]

  // Finanzas
  /**
   * /**
   * /**
   * /**
   * /**
   * Tarifa cobrada al aliado por cada afiliación/mensualidad de régimen
   * ORDINARIO procesada en el período contable. Null = sin configurar (no
   * se puede generar cobro hasta que staff la defina).
   */
  tarifaOrdinario    Decimal?               @db.Decimal(12, 2)
  /**
   * Tarifa equivalente para régimen RESOLUCION (Decreto 2616 / EPS+ARL).
   */
  tarifaResolucion   Decimal?               @db.Decimal(12, 2)
  cobrosAliado       CobroAliado[]
  movimientosDetalle MovimientoIncDetalle[]

  // Notificaciones dirigidas a esta sucursal (todos los usuarios que
  // pertenecen a ella las verán como destino).
  notificaciones Notificacion[] @relation("NotificacionSucursal")

  // Bitácora — eventos donde el usuario actor o la entidad afectada
  // pertenecía a esta sucursal al momento del evento.
  auditLogsComoActorSucursal   AuditLog[] @relation("AuditActorSucursal")
  auditLogsComoEntidadSucursal AuditLog[] @relation("AuditEntidadSucursal")

  @@map("sucursales")
}

// --- Usuario del sistema ---
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  sucursalId   String? // NULL solo para ADMIN/SOPORTE
  /**
   * Rol custom opcional. Si está seteado, los permisos efectivos del
   * usuario son los definidos en PermisoCustom para ese rol. Si es NULL,
   * el usuario usa la matriz Permiso del rol base.
   * Permite crear perfiles granulares (Operaciones, Facturación, etc.)
   * heredando de ALIADO_OWNER o SOPORTE.
   */
  rolCustomId  String?
  /**
   * FK al catálogo `AsesorComercial`. Requerido cuando `role = ASESOR_COMERCIAL`
   * (validado en la app, no en la BD para no romper backfills). El catálogo
   * sigue vivo y se referencia desde Afiliacion/Comprobante — este campo
   * solo agrega la capacidad de loguearse "como ese asesor". Un mismo
   * AsesorComercial puede tener a lo sumo un User asociado (@unique).
   */
  asesorComercialId String?  @unique
  /**
   * Sprint Chat interno — timestamp del último "heartbeat" del cliente.
   * Se actualiza cada ~60s mientras el user tenga el panel admin abierto
   * (via /api/presence/heartbeat). Si `now - lastActiveAt < 2 min` el
   * user se considera ONLINE para el widget de chat. Es indicativo, no
   * autoritativo — un crash de tab puede dejarlo "online" hasta que
   * pase el umbral.
   */
  lastActiveAt DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sucursal                Sucursal?                    @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  rolCustom               RolCustom?                   @relation(fields: [rolCustomId], references: [id], onDelete: SetNull)
  asesorComercial         AsesorComercial?             @relation(fields: [asesorComercialId], references: [id], onDelete: SetNull)
  empresas                UsuarioEmpresa[]
  comprobantesCreados     Comprobante[]                @relation("ComprobantesCreados")
  planillasCreadas        Planilla[]                   @relation("PlanillasCreadas")
  carterasCreadas         CarteraConsolidado[]         @relation("CarterasCreadas")
  carterasGestiones       CarteraGestion[]             @relation("CarterasGestionesUser")
  incapacidadesCreadas    Incapacidad[]                @relation("IncapacidadesCreadas")
  incapacidadesGestiones  IncapacidadGestion[]         @relation("IncapacidadGestionesUser")
  incapacidadesDocsUser   IncapacidadDocumento[]       @relation("IncapacidadDocumentoUser")
  soportesAfCreados       SoporteAfiliacion[]          @relation("SoporteAfCreator")
  soportesAfGestionados   SoporteAfiliacion[]          @relation("SoporteAfGestor")
  soportesAfAsignados     SoporteAfiliacion[]          @relation("SoporteAfAsignado")
  soportesAfGestionesUser SoporteAfGestion[]           @relation("SoporteAfGestionUser")
  soportesAfDocsUser      SoporteAfDocumento[]         @relation("SoporteAfDocUser")
  cobrosAliadoCreados     CobroAliado[]                @relation("CobroAliadoCreator")
  cobrosAliadoDocsUser    CobroAliadoDocumento[]       @relation("CobroAliadoDocUser")
  movimientosIncCreados   MovimientoIncapacidad[]      @relation("MovIncCreator")
  movimientosDetDocsUser  MovimientoDetalleDocumento[] @relation("MovDetDocUser")
  notificaciones          Notificacion[]               @relation("NotificacionDestino")
  auditLogsComoActor      AuditLog[]                   @relation("AuditActor")
  pqrsRespondidas         Pqrs[]                       @relation("PqrsRespondidoBy")
  pqrsGestiones           PqrsGestion[]                @relation("PqrsGestionUser")
  pqrsDocsUser            PqrsDocumento[]              @relation("PqrsDocUser")
  efipayTrxIniciadas      EfipayTransaccion[]          @relation("EfipayTrxIniciadaPor")
  colpatriaCertSolicitados ColpatriaCertificadoJob[]   @relation("ColpatriaCertSolicitante")
  reportesAtCreados        ReporteAccidenteTrabajo[]   @relation("ReporteATCreator")
  reportesAtGestionesUser  ReporteATGestion[]          @relation("ReporteATGestionUser")
  reportesAtDocsUser       ReporteATDocumento[]        @relation("ReporteATDocumentoUser")
  // Sprint Chat interno — relaciones inversas hacia el sub-grafo de mensajería.
  conversacionesCreadas    Conversacion[]              @relation("ConversacionCreator")
  conversacionParticipante ConversacionParticipante[]  @relation("ConversacionParticipanteUser")
  mensajesEnviados         Mensaje[]                   @relation("MensajeAutor")
  // Sprint Chat · cierre+rating
  conversacionesCerradasPor Conversacion[]              @relation("ConversacionCerradaPor")
  conversacionCalificaciones ConversacionCalificacion[] @relation("ConversacionCalificacionUser")
  // Sprint Chat · reacciones — un user puede reaccionar a varios mensajes.
  mensajeReacciones        MensajeReaccion[]           @relation("MensajeReaccionUser")
  // Sprint Chat · menciones — un user puede ser mencionado en varios mensajes.
  mensajeMenciones         MensajeMencion[]            @relation("MensajeMencionUser")
  // Sprint Comisiones — comisiones cerradas por este user (rol ADMIN).
  comisionesCerradas       ComisionAsesor[]            @relation("ComisionAsesorCerradaPor")

  @@index([sucursalId])
  @@index([rolCustomId])
  @@index([lastActiveAt(sort: Desc)])
  @@map("users")
}

// --- Empresa cliente — global, administrada solo por ADMIN ---
model Empresa {
  id     String @id @default(cuid())
  nit    String @unique // único globalmente
  nombre String // razón social

  // Identificación adicional (Fase 1.5.1 — nullable para migración no destructiva)
  dv              String?
  nombreComercial String?
  tipoPersona     TipoPersona?

  // Representante legal
  repLegalTipoDoc   TipoDocumento?
  repLegalNumeroDoc String?
  repLegalNombre    String?

  // Ubicación y contacto
  direccion      String?
  ciudad         String? // legado - texto libre (queda sincronizado con municipio.nombre si aplica)
  departamento   String? // legado - texto libre
  departamentoId String? // nuevo - FK a DIVIPOLA
  municipioId    String? // nuevo - FK a DIVIPOLA
  telefono       String?
  email          String?

  // PILA
  ciiuPrincipal          String?
  arlId                  String?
  /**
   * Fecha de inicio de actividades de la empresa — requerida por
   * PagoSimple al crear el aportante.
   */
  fechaInicioActividades DateTime?
  exoneraLey1607         Boolean       @default(false) // exoneración de aportes Ley 1607 de 2012
  arl                    EntidadSgss?  @relation("EmpresaArl", fields: [arlId], references: [id], onDelete: SetNull)
  departamentoRef        Departamento? @relation("EmpresaDepto", fields: [departamentoId], references: [id], onDelete: SetNull)
  municipioRef           Municipio?    @relation("EmpresaMuni", fields: [municipioId], references: [id], onDelete: SetNull)

  // PagoSimple — sincronización con operador PILA
  /**
   * /**
   * /**
   * /**
   * /** ID del aportante creado en PagoSimple bajo el usuario master.
   */
  pagosimpleContributorId String?
  /**
   * Última vez que se sincronizaron datos con el operador.
   */
  pagosimpleSyncedAt      DateTime?

  // ===== Bot Colpatria ARL (Sprint 8) =====
  // Cada empresa planilla afiliada a Colpatria ARL tiene credenciales
  // propias del portal. El bot las usa para iniciar sesión y procesar
  // afiliaciones automáticamente. Se llenan desde
  // /admin/empresas/[id]/colpatria por ADMIN únicamente.
  /**
   * /**
   * /** Si true, las afiliaciones nuevas/reactivadas de esta empresa
   * disparan automáticamente el bot. Si false, el bot ignora la empresa
   * (útil para empresas que aún no tienen credenciales o para pausar).
   */
  colpatriaActivo        Boolean   @default(false)
  /**
   * Usuario del portal Colpatria ARL para esta empresa.
   */
  colpatriaUsuario       String?
  /**
   * Password encriptado con AES-256-GCM (key en COLPATRIA_ENC_KEY del
   * env). Nunca se devuelve a la UI — la UI solo muestra
   * "configurado / no configurado".
   */
  colpatriaPasswordEnc   String?
  /**
   * Última vez que se cambió la credencial — para detectar logins que
   * fallan tras una rotación de password.
   */
  colpatriaPasswordSetAt DateTime?

  // --- Selectores del paso /Bienvenida (post-login) ---
  // El portal AXA pide elegir Aplicación/Perfil/Empresa/Afiliación. Estos
  // valores son específicos por empresa y se capturan una vez al
  // configurar el bot (visibles solo para ADMIN).
  /**
   * /** Código de Aplicación. En la práctica siempre "ARP" (Portal ARL).
   */
  colpatriaAplicacion       String? @default("ARP")
  /**
   * Código de Perfil: "OFI" (Oficial) u "OPE" (Operador).
   */
  colpatriaPerfil           String? @default("OFI")
  /**
   * ID interno de la empresa en AXA (option value de #ddlEmpresas).
   * No coincide con el NIT — son ~6 dígitos asignados por AXA.
   */
  colpatriaEmpresaIdInterno String?
  /**
   * Número de afiliación de la empresa con AXA (option value de
   * #ddlAfiliaciones). El bot usa esta que el ADMIN elige.
   */
  colpatriaAfiliacionId     String?

  // --- Defaults del form de Ingreso Individual ---
  // El form AXA pide ~10 campos que PILA no captura. Estos defaults los
  // usa el bot para todos los cotizantes de la empresa, así no saturamos
  // el form de afiliación con datos repetitivos.
  /**
   * /** Código de Sucursal default en Colpatria.
   */
  colpatriaCodigoSucursalDefault   String?
  /**
   * Tipo de afiliación default (código AXA del select TipoAfiliacion).
   */
  colpatriaTipoAfiliacionDefault   String?
  /**
   * Grupo de ocupación default (código AXA).
   */
  colpatriaGrupoOcupacionDefault   String?
  /**
   * Tipo de ocupación default (depende de GrupoOcupacion).
   */
  colpatriaTipoOcupacionDefault    String?
  // ModalidadTrabajo y TareaAltoRiesgo son hardcoded en el bot
  // ("01"=Presencial, "0000001"=No aplica) — sin campo configurable.

  // Relaciones de "permitidos" (Fase 1.5.3)
  nivelesPermitidos     EmpresaNivelRiesgo[]
  actividadesPermitidas EmpresaActividad[]
  tiposPermitidos       EmpresaTipoCotizante[]
  subtiposPermitidos    EmpresaSubtipoCotizante[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accesos                     UsuarioEmpresa[]
  afiliaciones                Afiliacion[]
  planillas                   Planilla[]
  carterasConsolidado         CarteraConsolidado[]
  incapacidades               Incapacidad[]            @relation("IncapacidadEmpresa")
  movimientosIncapacidad      MovimientoIncapacidad[]
  movimientosDetallePagadoCon MovimientoIncDetalle[]   @relation("MovDetallePagadoCon")
  colpatriaSesion             ColpatriaSesion?
  colpatriaJobs               ColpatriaAfiliacionJob[]
  colpatriaCertificadoJobs    ColpatriaCertificadoJob[]

  @@index([arlId])
  @@index([departamentoId])
  @@index([municipioId])
  @@map("empresas")
}

// Empresa ↔ niveles de riesgo ARL permitidos (I, II, III, IV, V).
// Para empresas con bot Colpatria activo, cada nivel puede mapearse a
// un código de "Centro de Trabajo" del portal AXA (Sprint 8). Ej:
// nivel I → centro 03, nivel II → centro 01. Si null, el bot usa el
// `colpatriaCodigoSucursalDefault` de la empresa.
model EmpresaNivelRiesgo {
  empresaId              String
  nivel                  NivelRiesgo
  /**
   * Código de Centro de Trabajo en Colpatria (Sprint 8). Null si la
   * empresa no usa bot Colpatria o si todos los niveles van al
   * default de la empresa.
   */
  colpatriaCentroTrabajo String?
  /**
   * Grupo Ocupacional AXA (código 1-3 dígitos) específico para este
   * nivel de riesgo. Null = usar default de empresa
   * (`colpatriaGrupoOcupacionDefault`). Sprint 8 / Opción B.
   */
  colpatriaGrupoOcupacion String?
  /**
   * Tipo de Ocupación AXA específico para este nivel. Depende del
   * grupo seleccionado (cascada AJAX en el portal). Null = usar
   * default empresa.
   */
  colpatriaTipoOcupacion  String?

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([empresaId, nivel])
  @@map("empresa_nivel_riesgo")
}

// Empresa ↔ actividades económicas adicionales permitidas
model EmpresaActividad {
  empresaId            String
  actividadEconomicaId String
  empresa              Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  actividad            ActividadEconomica @relation(fields: [actividadEconomicaId], references: [id], onDelete: Cascade)

  @@id([empresaId, actividadEconomicaId])
  @@map("empresa_actividad")
}

// Empresa ↔ tipos de cotizante permitidos
model EmpresaTipoCotizante {
  empresaId       String
  tipoCotizanteId String
  empresa         Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoCotizante   TipoCotizante @relation(fields: [tipoCotizanteId], references: [id], onDelete: Cascade)

  @@id([empresaId, tipoCotizanteId])
  @@map("empresa_tipo_cotizante")
}

// Empresa ↔ subtipos de cotizante permitidos
model EmpresaSubtipoCotizante {
  empresaId String
  subtipoId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  subtipo   Subtipo @relation(fields: [subtipoId], references: [id], onDelete: Cascade)

  @@id([empresaId, subtipoId])
  @@map("empresa_subtipo_cotizante")
}

// --- Permiso granular: qué usuario puede ver qué empresa ---
model UsuarioEmpresa {
  userId    String
  empresaId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([userId, empresaId])
  @@map("usuarios_empresas")
}

// --- Catálogos ---

// Entidades SGSS unificadas (EPS, AFP, ARL, CCF)
// Fase 1.6.1 — reemplaza el modelo Arl individual por una tabla tipada.
model EntidadSgss {
  id             String          @id @default(cuid())
  tipo           TipoEntidadSgss
  codigo         String
  nombre         String
  codigoMinSalud String?
  nit            String?
  /**
   * Código del catálogo AXA Colpatria (Sprint 8.5). Solo aplica a
   * EPS y AFP que el bot va a usar al llenar el form de Ingreso
   * Individual. Null para entidades que no necesitan mapeo (ARL, CCF).
   *
   * Ejemplo EPS: "1" = ALIANSALUD, "37" = SANITAS, etc.
   * Ejemplo AFP: depende del select del portal.
   *
   * Se configura desde /admin/catalogos/entidades (form de edición)
   * y se incluye en el payload del job para el bot.
   */
  codigoAxa      String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relaciones — empresas cuyo ARL actual es esta entidad
  empresasComoArl      Empresa[]     @relation("EmpresaArl")
  afiliacionesComoEps  Afiliacion[]  @relation("AfilEps")
  afiliacionesComoAfp  Afiliacion[]  @relation("AfilAfp")
  afiliacionesComoArl  Afiliacion[]  @relation("AfilArl")
  afiliacionesComoCcf  Afiliacion[]  @relation("AfilCcf")
  // Snapshots en incapacidades
  incapacidadesComoEps Incapacidad[] @relation("IncapacidadEps")
  incapacidadesComoAfp Incapacidad[] @relation("IncapacidadAfp")
  incapacidadesComoArl Incapacidad[] @relation("IncapacidadArl")
  incapacidadesComoCcf Incapacidad[] @relation("IncapacidadCcf")

  // Movimientos bancarios de incapacidades cuya entidad origen es ésta.
  movimientosIncapacidad MovimientoIncapacidad[] @relation("MovIncEntidad")

  @@unique([tipo, codigo])
  @@index([tipo])
  @@map("entidades_sgss")
}

model ActividadEconomica {
  id          String   @id @default(cuid())
  codigoCiiu  String   @unique
  descripcion String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresasPermitidas EmpresaActividad[]
  cargos             Cargo[]
  afiliaciones       Afiliacion[]

  @@map("actividades_economicas")
}

// Régimen aplicable a un Plan SGSS. Si es AMBOS, el plan puede usarse
// con cotizantes de cualquier régimen; si se restringe a ORDINARIO o
// RESOLUCION, la UI de afiliación solo permite elegirlo cuando coincide.
enum RegimenPlan {
  ORDINARIO
  RESOLUCION
  AMBOS
}

// Plan SGSS — combinación de entidades que un cotizante puede tener
// en una afiliación (p.ej. "EPS + ARL", "EPS + AFP + ARL"). El plan
// determina qué campos de entidades son requeridos/visibles en el form.
model PlanSgss {
  id          String      @id @default(cuid())
  codigo      String      @unique
  nombre      String
  descripcion String?
  incluyeEps  Boolean     @default(false)
  incluyeAfp  Boolean     @default(false)
  incluyeArl  Boolean     @default(false)
  incluyeCcf  Boolean     @default(false)
  regimen     RegimenPlan @default(AMBOS)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  afiliaciones Afiliacion[]

  @@index([regimen])
  @@map("planes_sgss")
}

// Formato del comprobante de pago — uno por sucursal (aliado).
// Personaliza logo, encabezado, pie de página y (futuro) campos JSON.
model ComprobanteFormato {
  id           String   @id @default(cuid())
  sucursalId   String   @unique
  nombre       String   @default("Predeterminado")
  logoUrl      String?
  encabezado   String?
  pieDePagina  String?
  camposConfig Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@map("comprobante_formatos")
}

// Cuenta de Cobro (Empresa Empleadora) — agrupador de cotizantes para
// facturación masiva. Scoped por sucursal (cada aliado mantiene las suyas).
model CuentaCobro {
  id                String         @id @default(cuid())
  sucursalId        String
  codigo            String
  razonSocial       String
  nit               String?
  dv                String?
  tipoPersona       TipoPersona?
  repLegalTipoDoc   TipoDocumento?
  repLegalNumeroDoc String?
  repLegalNombre    String?
  direccion         String?
  ciudad            String?
  departamento      String?
  telefono          String?
  email             String?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sucursal     Sucursal      @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  afiliaciones Afiliacion[]
  comprobantes Comprobante[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@map("cuentas_cobro")
}

// Cargo ocupacional — ligado a una actividad económica
model Cargo {
  id                   String   @id @default(cuid())
  codigo               String   @unique
  nombre               String
  actividadEconomicaId String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  actividad ActividadEconomica? @relation(fields: [actividadEconomicaId], references: [id], onDelete: SetNull)

  @@index([actividadEconomicaId])
  @@map("cargos")
}

// Asesor comercial — se ancla a cotizante para reportería/comisiones
// Asesor comercial — scoped por sucursal (cada aliado tiene los suyos).
// sucursalId null = recurso "global" visible por todas las sucursales
// (caso excepcional, gestionado por ADMIN/SOPORTE).
model AsesorComercial {
  id         String   @id @default(cuid())
  sucursalId String?
  codigo     String
  nombre     String
  email      String?
  telefono   String?
  active     Boolean  @default(true)
  /// Sprint Comisiones — si está activo, el asesor entra al cálculo de
  /// comisiones del periodo. Si false, las afiliaciones que radique no
  /// generan comisión (igual quedan amarradas para reportería).
  generaComision Boolean @default(false)
  /// Meta mensual (en COP) del asesor para el cálculo de comisiones.
  /// Base sobre la que se aplican los % (10/20/30/40). Null si todavía no
  /// se le asignó meta (entonces no se calcula comisión).
  metaMensual Decimal? @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sucursal     Sucursal?     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  afiliaciones Afiliacion[]
  comprobantes Comprobante[]
  comisiones   ComisionAsesor[]
  /**
   * User opcional con login asociado a este asesor. 1:1. Si está seteado,
   * ese user (rol=ASESOR_COMERCIAL) verá las afiliaciones/cartera amarradas
   * a este registro. Borrar el User libera la relación (SetNull en el lado
   * de User) — el catálogo nunca se pierde.
   */
  user         User?

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@map("asesores_comerciales")
}

/// Sprint Comisiones — snapshot del cálculo de comisión de un asesor en
/// un periodo contable. Se crea cuando ADMIN cierra la comisión del
/// periodo: congela el desglose de las 3 reglas + el bono y el monto
/// final. Antes del cierre, el cálculo vive solo en `calcularComisionAction`
/// (no hay fila).
///
/// Reglas (cada una 10%):
///   A — valorAfiliacionesNuevas >= metaMensual (cumplimiento de meta)
///   B — afiliacionesIndependientes >= 3
///   C — porcentajeRetiros <= 8%
/// Bono: +10% si se cumplen las 3 → total 40% máximo.
/// `valorComision = metaMensual × porcentajeAplicado`.
model ComisionAsesor {
  id        String   @id @default(cuid())
  asesorId  String
  periodoId String
  /// Meta del asesor al momento del snapshot (denormalizada — no leemos
  /// `AsesorComercial.metaMensual` al mostrar histórico, por si cambió).
  meta      Decimal  @db.Decimal(15, 2)

  /// Σ Liquidacion.totalGeneral del periodo, donde tipo=VINCULACION y
  /// la afiliación pertenece al asesor.
  valorAfiliacionesNuevas Decimal @default(0) @db.Decimal(15, 2)
  cumplimientoMeta        Boolean @default(false)

  /// Cantidad de afiliaciones nuevas en el periodo con modalidad
  /// INDEPENDIENTE (subconjunto de las que cuentan para meta).
  afiliacionesIndependientes Int     @default(0)
  cumplimientoIndependientes Boolean @default(false)

  /// % de retiros sobre cotizantes activos al inicio del periodo.
  /// retiros = COUNT(Afiliacion WHERE fechaRetiro en periodo AND asesor=X)
  /// activosInicio = COUNT(Afiliacion ACTIVA antes del 1 del mes AND asesor=X)
  porcentajeRetiros   Decimal @default(0) @db.Decimal(5, 2)
  cumplimientoRetiros Boolean @default(false)

  /// True si A && B && C. Dispara el bono del 10%.
  cumpleLas3        Boolean @default(false)
  /// Porcentaje aplicado: 0, 10, 20, 30 o 40.
  porcentajeAplicado Decimal @default(0) @db.Decimal(5, 2)
  /// Monto final: meta × porcentajeAplicado / 100. Snapshoteado al cerrar.
  valorComision      Decimal @default(0) @db.Decimal(15, 2)

  estado          EstadoComisionAsesor @default(CERRADA)
  cerradaPorUserId String?
  cerradaAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  asesor       AsesorComercial @relation(fields: [asesorId], references: [id], onDelete: Restrict)
  periodo      PeriodoContable @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  cerradaPor   User?           @relation("ComisionAsesorCerradaPor", fields: [cerradaPorUserId], references: [id], onDelete: SetNull)

  @@unique([asesorId, periodoId])
  @@index([periodoId])
  @@index([asesorId, periodoId])
  @@map("comisiones_asesor")
}

enum EstadoComisionAsesor {
  /// Por si en el futuro queremos un estado "calculada pero no cerrada".
  /// Por ahora se crea directamente CERRADA cuando ADMIN dispara el cierre.
  ABIERTA
  CERRADA
}

// Medio de pago — scoped por sucursal
model MedioPago {
  id         String   @id @default(cuid())
  sucursalId String?
  codigo     String
  nombre     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sucursal     Sucursal?     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  comprobantes Comprobante[]
  cobrosAliado CobroAliado[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@map("medios_pago")
}

// Servicio adicional — scoped por sucursal (cada aliado puede tener sus
// propios planes/servicios extra).
model ServicioAdicional {
  id          String   @id @default(cuid())
  sucursalId  String?
  codigo      String
  nombre      String
  descripcion String?
  precio      Decimal  @default(0) @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sucursal     Sucursal?            @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  afiliaciones AfiliacionServicio[]

  @@unique([sucursalId, codigo])
  @@index([sucursalId])
  @@map("servicios_adicionales")
}

model TipoCotizante {
  id        String    @id @default(cuid())
  codigo    String    @unique
  nombre    String
  modalidad Modalidad @default(DEPENDIENTE)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subtipos           Subtipo[]
  empresasPermitidas EmpresaTipoCotizante[]
  afiliaciones       Afiliacion[]

  @@map("tipos_cotizante")
}

model Subtipo {
  id              String   @id @default(cuid())
  codigo          String
  nombre          String
  tipoCotizanteId String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tipoCotizante      TipoCotizante             @relation(fields: [tipoCotizanteId], references: [id], onDelete: Cascade)
  empresasPermitidas EmpresaSubtipoCotizante[]
  afiliaciones       Afiliacion[]

  @@unique([codigo, tipoCotizanteId])
  @@index([tipoCotizanteId])
  @@map("subtipos_cotizante")
}

// --- Cotizante (cliente afiliado) y Afiliación (Fase 2.1) ---

model Cotizante {
  id                      String        @id @default(cuid())
  /**
   * Sucursal dueña del registro (multi-tenant). Cada sucursal maneja sus
   * propios cotizantes — la misma persona puede existir como dos registros
   * en sucursales distintas. sucursalId=null se reserva para cotizantes
   * legados sin asignar (staff los puede migrar desde la UI).
   */
  sucursalId              String?
  tipoDocumento           TipoDocumento
  numeroDocumento         String
  fechaExpedicionDoc      DateTime?
  primerNombre            String
  segundoNombre           String?
  primerApellido          String
  segundoApellido         String?
  fechaNacimiento         DateTime
  genero                  Genero
  /**
   * Estado civil. Sprint 8 (Bot Colpatria). Códigos AXA:
   * 1=Soltero, 2=Casado, 3=Unión Libre, 4=Viudo, 5=Divorciado.
   * Nullable para no romper datos existentes.
   */
  estadoCivil             String?
  telefono                String?
  celular                 String?
  email                   String?
  direccion               String?
  municipioId             String?
  departamentoId          String?
  /**
   * ID del aportante INDEPENDIENTE creado en PagoSimple (aplica solo a
   * cotizantes con modalidad independiente; null para dependientes).
   */
  pagosimpleContributorId String?
  pagosimpleSyncedAt      DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  sucursal           Sucursal?              @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  afiliaciones       Afiliacion[]
  comprobantes       Comprobante[]
  gestionesCartera   GestionCartera[]
  planillas          Planilla[]
  carterasDetallado  CarteraDetallado[]
  incapacidades      Incapacidad[]
  soportesAfiliacion SoporteAfiliacion[]
  reportesAt         ReporteAccidenteTrabajo[]
  movimientosDetalle MovimientoIncDetalle[]
  municipio          Municipio?             @relation(fields: [municipioId], references: [id], onDelete: SetNull)
  departamento       Departamento?          @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  @@unique([sucursalId, tipoDocumento, numeroDocumento])
  @@index([sucursalId])
  @@index([primerApellido, primerNombre])
  @@index([municipioId])
  @@index([departamentoId])
  @@map("cotizantes")
}

// Afiliación — liga un cotizante a una empresa con su plan (tipo/subtipo/nivel/salario).
// Para INDEPENDIENTE, empresaId y regimen no aplican y arlId se elige directamente.
model Afiliacion {
  id                   String           @id @default(cuid())
  cotizanteId          String
  empresaId            String?
  cuentaCobroId        String?
  asesorComercialId    String?
  planSgssId           String?
  actividadEconomicaId String?
  tipoCotizanteId      String
  subtipoId            String?
  modalidad            Modalidad        @default(DEPENDIENTE)
  nivelRiesgo          NivelRiesgo
  regimen              Regimen?
  formaPago            FormaPago? // sólo INDEPENDIENTE
  salario              Decimal          @db.Decimal(12, 2)
  valorAdministracion  Decimal          @db.Decimal(12, 2)
  fechaIngreso         DateTime
  fechaRetiro          DateTime?
  estado               EstadoAfiliacion @default(ACTIVA)
  comentarios          String?

  // --- Datos requeridos por bot Colpatria ARL (Sprint 8) ---
  // Aplican principalmente a DEPENDIENTE. Nullable para no romper
  // afiliaciones existentes. El bot exige `cargo` — si viene vacío
  // cuando se procesa, el job falla con FAILED.
  // TipoSalario, ModalidadTrabajo y TareaAltoRiesgo son hardcoded en el
  // bot ("1"=Básico, "01"=Presencial, "0000001"=No aplica) — no se
  // configuran ni en empresa ni en afiliación.
  /// Cargo del cotizante en la empresa. Ej: "Operario", "Asesor".
  cargo       String?

  // Entidades SGSS asignadas (EntidadSgss filtrada por tipo)
  epsId String?
  afpId String?
  arlId String? // solo para INDEPENDIENTE — el dependiente hereda la ARL de la empresa
  ccfId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cotizante          Cotizante           @relation(fields: [cotizanteId], references: [id], onDelete: Cascade)
  empresa            Empresa?            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cuentaCobro        CuentaCobro?        @relation(fields: [cuentaCobroId], references: [id], onDelete: SetNull)
  asesorComercial    AsesorComercial?    @relation(fields: [asesorComercialId], references: [id], onDelete: SetNull)
  planSgss           PlanSgss?           @relation(fields: [planSgssId], references: [id], onDelete: SetNull)
  actividadEconomica ActividadEconomica? @relation(fields: [actividadEconomicaId], references: [id], onDelete: SetNull)
  tipoCotizante      TipoCotizante       @relation(fields: [tipoCotizanteId], references: [id], onDelete: Restrict)
  subtipo            Subtipo?            @relation(fields: [subtipoId], references: [id], onDelete: SetNull)
  eps                EntidadSgss?        @relation("AfilEps", fields: [epsId], references: [id], onDelete: SetNull)
  afp                EntidadSgss?        @relation("AfilAfp", fields: [afpId], references: [id], onDelete: SetNull)
  arl                EntidadSgss?        @relation("AfilArl", fields: [arlId], references: [id], onDelete: SetNull)
  ccf                EntidadSgss?        @relation("AfilCcf", fields: [ccfId], references: [id], onDelete: SetNull)

  serviciosAdicionales AfiliacionServicio[]
  liquidaciones        Liquidacion[]
  soportes             SoporteAfiliacion[]
  colpatriaJobs        ColpatriaAfiliacionJob[]
  colpatriaCertificadoJobs ColpatriaCertificadoJob[]

  /**
   * Sprint Soporte reorg fase 2 — un cotizante puede tener máximo dos
   * afiliaciones: una `DEPENDIENTE` y una `INDEPENDIENTE`. Si se inactiva
   * y luego vuelve a entrar, se REACTIVA el registro existente; no se
   * crea uno nuevo. Esto evita que el historial quede inflado con
   * duplicados y hace fácil saber cuál es la afiliación vigente del
   * cotizante.
   */
  @@unique([cotizanteId, modalidad])
  @@index([cotizanteId])
  @@index([empresaId])
  @@index([estado])
  @@index([modalidad])
  @@index([actividadEconomicaId])
  @@index([arlId])
  @@map("afiliaciones")
}

// Servicios adicionales asignados a una afiliación (many-to-many)
model AfiliacionServicio {
  afiliacionId        String
  servicioAdicionalId String
  createdAt           DateTime @default(now())

  afiliacion Afiliacion        @relation(fields: [afiliacionId], references: [id], onDelete: Cascade)
  servicio   ServicioAdicional @relation(fields: [servicioAdicionalId], references: [id], onDelete: Cascade)

  @@id([afiliacionId, servicioAdicionalId])
  @@map("afiliacion_servicios")
}

// --- Configuración SMLV (singleton) ---
// El admin actualiza el valor; al guardar se cascadea a todas las
// afiliaciones con salario < valor nuevo.
model SmlvConfig {
  id           String   @id @default("singleton")
  valor        Decimal  @db.Decimal(12, 2)
  vigenteDesde DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("smlv_config")
}

// --- Tarifas SGSS (Fase 2.8) ---
// Catálogo de porcentajes por concepto (EPS/AFP/ARL/CCF/SENA/ICBF) con
// discriminadores por modalidad, nivel ARL y exoneración (Ley 1607).
// Una fila representa un porcentaje aplicable en una combinación. El
// motor de liquidación consulta este catálogo para armar la planilla.
//
// `concepto` es string plano (no enum) para poder añadir conceptos
// nuevos sin migración (ej. FIC, AFC, etc. en el futuro).
model TarifaSgss {
  id            String       @id @default(cuid())
  concepto      String // EPS | AFP | ARL | CCF | SENA | ICBF
  modalidad     Modalidad? // NULL = aplica a ambas (AFP, ARL)
  nivelRiesgo   NivelRiesgo? // sólo ARL
  exonera       Boolean? // NULL = no aplica (ARL/AFP); true/false para EPS/SENA/ICBF en DEPENDIENTE
  porcentaje    Decimal      @db.Decimal(6, 4) // ej 12.5000 = 12.5%
  etiqueta      String? // nombre corto mostrado en UI (p. ej. "CCF Independiente 2%")
  observaciones String?
  active        Boolean      @default(true)
  vigenteDesde  DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([concepto])
  @@index([active])
  @@map("tarifas_sgss")
}

// --- Transacciones / Liquidación (Fase 3.0) ---

enum EstadoPeriodo {
  ABIERTO // se pueden liquidar/editar afiliaciones
  CERRADO // snapshot final; no se permite recalcular
}

enum EstadoLiquidacion {
  BORRADOR // recién calculada por el motor
  REVISADA // admin la revisó y aprobó
  PAGADA // con pago aplicado
  ANULADA
}

// Tipo de liquidación dentro de un período:
// VINCULACION = primer comprobante del afiliado, días proporcionales
//               desde fecha de ingreso al día 30 PILA
// MENSUALIDAD = mes completo (30 días PILA)
enum TipoLiquidacion {
  VINCULACION
  MENSUALIDAD
}

// Comprobantes — agrupadores de liquidaciones con consecutivo propio.
enum TipoComprobante {
  AFILIACION // primer comprobante del cotizante (engloba las VINCULACION)
  MENSUALIDAD // comprobante regular del mes
}

enum AgrupacionComprobante {
  INDIVIDUAL // 1 cotizante
  EMPRESA_CC // todos los cotizantes de una cuenta de cobro
  ASESOR_COMERCIAL // todos los cotizantes de un asesor (reporte / comisión)
}

enum EstadoComprobante {
  BORRADOR // recién generado
  EMITIDO // firmado/impreso
  PAGADO
  ANULADO
}

// Forma de pago al procesar una transacción.
// POR_CONFIGURACION = toma la forma de pago configurada (ej. Nequi/Bancolombia)
// CONSOLIDADO       = pago consolidado (múltiples liquidaciones agrupadas)
// POR_MEDIO_PAGO    = se referencia un MedioPago específico del catálogo
enum FormaPagoTransaccion {
  POR_CONFIGURACION
  CONSOLIDADO
  POR_MEDIO_PAGO
}

// Período contable mensual — uno por (año, mes). El admin abre el período,
// corre la liquidación, revisa y eventualmente cierra. SMLV y tarifas
// vigentes al momento de abrir quedan denormalizadas en cada liquidación.
model PeriodoContable {
  id            String        @id @default(cuid())
  anio          Int
  mes           Int // 1..12
  estado        EstadoPeriodo @default(ABIERTO)
  smlvSnapshot  Decimal       @db.Decimal(12, 2) // SMLV vigente al abrir
  observaciones String?
  abiertoEn     DateTime      @default(now())
  cerradoEn     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  liquidaciones      Liquidacion[]
  comprobantes       Comprobante[]
  gestionesCartera   GestionCartera[]
  planillas          Planilla[]
  soportesAfiliacion SoporteAfiliacion[]
  cobrosAliado       CobroAliado[]
  comisionesAsesor   ComisionAsesor[]

  @@unique([anio, mes])
  @@index([estado])
  @@map("periodos_contables")
}

// Liquidación — una por (periodo × afiliación). El motor genera el
// desglose en `LiquidacionConcepto`. El `ibc` es la base de cotización
// del período (puede ser distinta al salario por novedades futuras).
model Liquidacion {
  id                String            @id @default(cuid())
  periodoId         String
  afiliacionId      String
  tipo              TipoLiquidacion   @default(MENSUALIDAD)
  ibc               Decimal           @db.Decimal(12, 2)
  // Período al que corresponde el APORTE SGSS (clave para el plano PILA).
  // Puede diferir del `periodoId` cuando es un independiente con forma
  // de pago VENCIDO: se factura en el mes siguiente pero cotiza por el
  // mes anterior. NULL → mismo mes que el período contable.
  periodoAporteAnio Int?
  periodoAporteMes  Int?
  diasCotizados     Int               @default(30) // sobre mes PILA de 30 días
  diaDesde          Int? // día (1..30) de inicio del periodo cotizado; NULL = mes completo
  diaHasta          Int? // día (1..30) de fin del periodo cotizado; NULL = mes completo
  totalEmpleador    Decimal           @default(0) @db.Decimal(14, 2)
  totalTrabajador   Decimal           @default(0) @db.Decimal(14, 2)
  totalGeneral      Decimal           @default(0) @db.Decimal(14, 2)
  totalPagado       Decimal           @default(0) @db.Decimal(14, 2)
  estado            EstadoLiquidacion @default(BORRADOR)
  observaciones     String?
  calculadoEn       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  periodo      PeriodoContable          @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  afiliacion   Afiliacion               @relation(fields: [afiliacionId], references: [id], onDelete: Cascade)
  conceptos    LiquidacionConcepto[]
  comprobantes ComprobanteLiquidacion[]

  @@unique([periodoId, afiliacionId, tipo])
  @@index([periodoId])
  @@index([afiliacionId])
  @@index([estado])
  @@index([tipo])
  // Sprint perf — filtro común en transacciones/actions: liquidaciones
  // de una afiliación filtradas por estado (BORRADOR/REVISADA/PAGADA).
  @@index([afiliacionId, estado])
  @@map("liquidaciones")
}

// Desglose línea-por-concepto de una liquidación. Se recrea en cada
// recálculo (deleteMany + createMany dentro de transacción).
// `aCargoEmpleador` indica si el valor pesa sobre el empleador (para
// dependientes) o sobre el trabajador/aportante.
model LiquidacionConcepto {
  id              String   @id @default(cuid())
  liquidacionId   String
  concepto        String // EPS | AFP | ARL | CCF | SENA | ICBF | FSP | ADMIN
  subconcepto     String? // ej. "EPS-empleador 8.5%" vs "EPS-trabajador 4%"
  base            Decimal  @db.Decimal(12, 2)
  // Decimal(8,4) para soportar hasta 9999.9999. El concepto ADMIN usa
  // 100.0000 ya que no es realmente un porcentaje sino un valor fijo.
  porcentaje      Decimal  @db.Decimal(8, 4)
  valor           Decimal  @db.Decimal(14, 2)
  aCargoEmpleador Boolean  @default(true)
  observaciones   String?
  createdAt       DateTime @default(now())

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([liquidacionId])
  @@index([concepto])
  @@map("liquidacion_conceptos")
}

// FSP — Fondo de Solidaridad Pensional. Tabla por rangos de SMLV del
// ingreso base de cotización. smlvHasta NULL = rango sin tope superior.
model FspRango {
  id           String   @id @default(cuid())
  smlvDesde    Decimal  @db.Decimal(6, 2)
  smlvHasta    Decimal? @db.Decimal(6, 2)
  porcentaje   Decimal  @db.Decimal(6, 4)
  active       Boolean  @default(true)
  vigenteDesde DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@map("fsp_rangos")
}

// --- Departamentos y municipios de Colombia (DIVIPOLA) ---
model Departamento {
  id     String @id @default(cuid())
  codigo String @unique // DIVIPOLA 2 dígitos
  nombre String @unique

  municipios Municipio[]
  cotizantes Cotizante[]
  empresas   Empresa[]   @relation("EmpresaDepto")

  @@map("departamentos")
}

model Municipio {
  id             String @id @default(cuid())
  codigo         String @unique // DIVIPOLA 5 dígitos
  nombre         String
  departamentoId String

  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  cotizantes   Cotizante[]
  empresas     Empresa[]    @relation("EmpresaMuni")

  @@unique([nombre, departamentoId])
  @@index([departamentoId])
  @@map("municipios")
}

// --- Comprobantes (Fase 3.2) ---
// Un comprobante agrupa 1..N liquidaciones y se emite al destinatario
// (cotizante, cuenta de cobro o asesor) con un consecutivo propio.
model Comprobante {
  id                String                @id @default(cuid())
  periodoId         String
  tipo              TipoComprobante
  agrupacion        AgrupacionComprobante
  consecutivo       String                @unique // CMP-000001
  // Destinatario: según `agrupacion`, uno de estos está poblado
  cotizanteId       String?
  cuentaCobroId     String?
  asesorComercialId String?
  // Totales denormalizados — se desglosan para facturación y reporte.
  // totalGeneral = totalSgss + totalAdmon + totalServicios
  totalSgss         Decimal               @default(0) @db.Decimal(14, 2)
  totalAdmon        Decimal               @default(0) @db.Decimal(14, 2)
  totalServicios    Decimal               @default(0) @db.Decimal(14, 2)
  totalEmpleador    Decimal               @default(0) @db.Decimal(14, 2) // (legado — no se muestra en UI)
  totalTrabajador   Decimal               @default(0) @db.Decimal(14, 2) // (legado — no se muestra en UI)
  totalGeneral      Decimal               @default(0) @db.Decimal(14, 2)
  totalPagado       Decimal               @default(0) @db.Decimal(14, 2)
  estado            EstadoComprobante     @default(BORRADOR)
  observaciones     String?

  // Pre-facturación y procesamiento
  numeroComprobanteExt String? // número impreso / externo ingresado por el admin
  formaPago            FormaPagoTransaccion?
  fechaPago            DateTime?
  medioPagoId          String?
  procesadoEn          DateTime? // timestamp del click "Procesar"
  emitidoEn            DateTime?
  pagadoEn             DateTime?

  // Override de valor administración en la pre-factura (afecta sólo la
  // transacción, no el valor guardado en la afiliación). Si es NULL, se
  // usó el valor default de la afiliación.
  valorAdminOverride Decimal? @db.Decimal(12, 2)

  // Marca que al procesar esta factura se inactivó al cotizante (novedad
  // de retiro). Al anular se reactiva.
  aplicaNovedadRetiro Boolean @default(false)

  // Marca que esta factura se creó durante el cierre masivo del período.
  // Al anularse, el período se reabre automáticamente.
  esCierreMasivo Boolean @default(false)

  // Número de planilla PILA asignado cuando se procesa en el módulo de
  // Planos. Mientras NULL, la transacción se muestra "En proceso".
  numeroPlanilla String?

  // Usuario que creó (procesó) el comprobante. SetNull si el usuario
  // se elimina para no perder el registro.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodo         PeriodoContable          @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  cotizante       Cotizante?               @relation(fields: [cotizanteId], references: [id], onDelete: Restrict)
  cuentaCobro     CuentaCobro?             @relation(fields: [cuentaCobroId], references: [id], onDelete: Restrict)
  asesorComercial AsesorComercial?         @relation(fields: [asesorComercialId], references: [id], onDelete: Restrict)
  medioPago       MedioPago?               @relation(fields: [medioPagoId], references: [id], onDelete: SetNull)
  createdBy       User?                    @relation("ComprobantesCreados", fields: [createdById], references: [id], onDelete: SetNull)
  liquidaciones   ComprobanteLiquidacion[]
  planillas       PlanillaComprobante[]

  @@index([periodoId])
  @@index([estado])
  @@index([tipo, agrupacion])
  @@index([cotizanteId])
  @@index([cuentaCobroId])
  @@index([asesorComercialId])
  @@index([medioPagoId])
  @@index([procesadoEn])
  @@index([numeroPlanilla])
  @@index([createdById])
  @@map("comprobantes")
}

// Bitácora de gestión de cartera — registra las acciones del admin
// para cobrar a un cotizante en un período (llamadas, emails, notas).
model GestionCartera {
  id          String   @id @default(cuid())
  cotizanteId String
  periodoId   String
  accion      String // LLAMADA | EMAIL | SMS | VISITA | NOTA | OTRO
  descripcion String
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())

  cotizante Cotizante       @relation(fields: [cotizanteId], references: [id], onDelete: Cascade)
  periodo   PeriodoContable @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  @@index([cotizanteId])
  @@index([periodoId])
  @@index([cotizanteId, periodoId])
  @@map("gestiones_cartera")
}

// Pivote m2m. Una liquidación puede estar en varios comprobantes (p.ej.
// el de cobro por CC + el informativo del asesor), por eso NO hay
// unique sobre liquidacionId.
model ComprobanteLiquidacion {
  comprobanteId String
  liquidacionId String

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@id([comprobanteId, liquidacionId])
  @@index([liquidacionId])
  @@map("comprobante_liquidaciones")
}

// --- Planos PILA (Fase P1) ---

// Tipo de planilla según resolución 2388/2016 (campo 8 del encabezado).
// Arrancamos con E (empleados) e I (independientes); ampliar a N/Y/K/otros
// según aparezcan casos.
enum TipoPlanilla {
  E // Planilla empleados (dependientes)
  I // Planilla independientes
  Y // Planilla independientes empresa (cooperativas, asociados)
  N // Planilla correcciones
  K // Planilla estudiantes
  A // Planilla cotizantes con novedad de ingreso
  S // Planilla empleados servicio doméstico
}

enum EstadoPlanilla {
  CONSOLIDADO // Recién creada, pendiente de pago
  PAGADA // Pago confirmado — se guarda numeroPlanillaExt y fecha
  ANULADA // Al anular se libera el vínculo con los comprobantes
}

// Planilla PILA — un registro agrupa los comprobantes de UN aportante
// (empresa para dependientes / cotizante para independientes) en un
// período de aporte. Un aportante puede tener varias planillas si hay
// desfase por independiente vencido u otro caso.
model Planilla {
  id                 String         @id @default(cuid())
  periodoId          String
  /**
   * Sucursal que genera la planilla (multi-tenant). Cuando una empresa
   * planilla global tiene cotizantes de múltiples aliados, se genera una
   * planilla tipo E por sucursal. Para planillas tipo I, coincide con
   * `cotizante.sucursalId`.
   */
  sucursalId         String?
  consecutivo        String         @unique // PLN-000001 (sequence Postgres)
  tipoPlanilla       TipoPlanilla
  // Nro. de planilla asignado por el operador PILA al confirmar el pago
  numeroPlanillaExt  String?
  // Aportante: exactamente UNO de estos está poblado según tipoPlanilla
  empresaId          String? // NOT NULL si tipo = E (dependientes)
  cotizanteId        String? // NOT NULL si tipo = I/Y (independiente)
  // Período de APORTE (puede diferir del contable para indep vencido)
  periodoAporteAnio  Int
  periodoAporteMes   Int
  // Totales snapshot por subsistema
  totalSalud         Decimal        @default(0) @db.Decimal(14, 2)
  totalPension       Decimal        @default(0) @db.Decimal(14, 2)
  totalArl           Decimal        @default(0) @db.Decimal(14, 2)
  totalCcf           Decimal        @default(0) @db.Decimal(14, 2)
  totalSena          Decimal        @default(0) @db.Decimal(14, 2)
  totalIcbf          Decimal        @default(0) @db.Decimal(14, 2)
  totalFsp           Decimal        @default(0) @db.Decimal(14, 2)
  totalGeneral       Decimal        @default(0) @db.Decimal(14, 2)
  cantidadCotizantes Int            @default(0)
  estado             EstadoPlanilla @default(CONSOLIDADO)
  generadoEn         DateTime       @default(now())
  pagadoEn           DateTime?
  createdById        String?
  observaciones      String?

  // PagoSimple — integración con operador PILA
  /**
   * /**
   * /**
   * /**
   * /** payroll_number devuelto por POST /payroll/validate.
   */
  pagosimpleNumero           String?
  /**
   * PIN asignado en marcación asistida (si aplica).
   */
  pagosimplePin              String?
  /**
   * Estado de la última validación: OK, CON_ERRORES, etc.
   */
  pagosimpleEstadoValidacion String?
  /**
   * URL PSE de pago (se cachea al generarla).
   */
  pagosimplePaymentUrl       String?
  /**
   * Totales calculados por el operador (GET /payroll/total). Pueden
   * diferir de los locales por ajustes de validación o mora.
   * `pagosimpleTotalSgss` = total sin mora; `pagosimpleTotalMora` =
   * intereses por días vencidos; `pagosimpleTotalPagar` = total a girar.
   */
  pagosimpleTotalSgss        Decimal?  @db.Decimal(14, 2)
  pagosimpleTotalMora        Decimal?  @db.Decimal(14, 2)
  pagosimpleTotalPagar       Decimal?  @db.Decimal(14, 2)
  /**
   * Última vez que se sincronizaron datos con el operador.
   */
  pagosimpleSyncedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodo      PeriodoContable       @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  sucursal     Sucursal?             @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  empresa      Empresa?              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cotizante    Cotizante?            @relation(fields: [cotizanteId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation("PlanillasCreadas", fields: [createdById], references: [id], onDelete: SetNull)
  comprobantes PlanillaComprobante[]

  @@index([periodoId])
  @@index([sucursalId])
  @@index([estado])
  @@index([tipoPlanilla])
  @@index([empresaId])
  @@index([cotizanteId])
  @@index([periodoAporteAnio, periodoAporteMes])
  @@map("planillas")
}

// Pivote Planilla ↔ Comprobante. Un comprobante puede estar en varias
// planillas (p.ej. una afiliación de RESOLUCIÓN con plan EPS+ARL genera
// dos planillas — tipo E y tipo K — que referencian al mismo comprobante).
// La PK compuesta @@id evita duplicados dentro de la misma planilla.
// Al anular la planilla se borran estas filas (cascade).
model PlanillaComprobante {
  planillaId    String
  comprobanteId String
  createdAt     DateTime @default(now())

  planilla    Planilla    @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Restrict)

  @@id([planillaId, comprobanteId])
  @@index([comprobanteId])
  @@map("planillas_comprobantes")
}

// ============================================================
// MÓDULO CARTERA (Soporte + Administrativo)
// ============================================================
// Estados de cuenta importados desde las entidades SGSS (EPS/AFP/ARL/CCF)
// vía PDF. El módulo Soporte los carga y los pasa a "CARTERA_REAL" cuando
// confirma que la deuda es válida; a partir de ese estado aparecen en el
// módulo Administrativo del aliado dueño de la sucursal asignada.

/**
 * Tipo de entidad SGSS emisora del estado de cuenta.
 */
enum CarteraTipoEntidad {
  EPS
  AFP
  ARL
  CCF
}

/**
 * Estado del detallado (por línea) y también del consolidado.
 * - EN_CONCILIACION      recién importado; soporte lo revisa
 * - CONCILIADA           soporte respondió a la entidad / descartó la deuda
 * - CARTERA_REAL         soporte confirmó: es deuda real → aparece en el aliado
 * - PAGADA_CARTERA_REAL  el aliado pagó la cartera real confirmada
 */
enum CarteraEstado {
  EN_CONCILIACION // estado inicial — recién importado o sin respuesta
  CONCILIADA // ya cerrado con la entidad (consolidado o línea)
  ENVIADA // consolidado: soporte respondió a la entidad, espera confirmación
  MORA_REAL // línea: deuda probable confirmada, visible al aliado
  CARTERA_REAL // línea: deuda firme, visible al aliado
  PAGADA_CARTERA_REAL // línea: el aliado pagó la deuda
}

/**
 * Origen del PDF — detectado por el parser; MANUAL = el staff lo mapeó a mano.
 */
enum CarteraOrigenPdf {
  PROTECCION
  SALUD_TOTAL
  EPS_SOS
  EPS_SURA
  EPS_SANITAS
  MANUAL
}

/**
 * Quién registró la gestión: staff de soporte o el aliado dueño de la sucursal.
 */
enum CarteraAccionadaPor {
  SOPORTE
  ALIADO
}

/**
 * Cabecera del estado de cuenta importado. Un consolidado agrupa todas
 * las líneas (CarteraDetallado) de un mismo PDF: la entidad emisora, la
 * empresa afectada y el período de corte.
 * La unique `(empresaNit, entidadNombre, periodoHasta)` bloquea re-imports
 * silenciosos: si el staff sube dos veces el mismo estado de cuenta, el
 * action exige confirmación explícita para reemplazar.
 */
model CarteraConsolidado {
  id                  String             @id @default(cuid())
  consecutivo         String             @unique // CC-000001 (sequence Postgres)
  fechaRegistro       DateTime           @default(now())
  tipoEntidad         CarteraTipoEntidad
  entidadNombre       String // "Salud Total EPS"
  entidadNit          String? // NIT de la entidad (si el PDF lo trae)
  empresaNit          String // NIT empleador reportado en el PDF
  empresaRazonSocial  String // razón social del PDF (denormalizada)
  empresaId           String? // match con Empresa en BD (si existe)
  periodoDesde        String? // "AAAA-MM" — inicio de la ventana reportada
  periodoHasta        String? // "AAAA-MM" — corte del estado de cuenta
  cantidadRegistros   Int                @default(0)
  valorTotalInformado Decimal            @db.Decimal(15, 2)
  estado              CarteraEstado      @default(EN_CONCILIACION)
  origenPdf           CarteraOrigenPdf?
  archivoOrigenPath   String? // ruta relativa al PDF archivado
  archivoOrigenHash   String? // sha-256 para trazabilidad
  observaciones       String?
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  empresa   Empresa?           @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("CarterasCreadas", fields: [createdById], references: [id], onDelete: SetNull)
  detallado CarteraDetallado[]

  @@unique([empresaNit, entidadNombre, periodoHasta])
  @@index([empresaId])
  @@index([estado])
  @@index([fechaRegistro])
  @@map("cartera_consolidado")
}

/**
 * Una línea del estado de cuenta = un cotizante + un período + un valor.
 * El estado es por línea (no solo por consolidado) — solo las líneas
 * marcadas CARTERA_REAL aparecen en el módulo Administrativo del aliado.
 * `sucursalAsignadaId` se auto-matchea por cédula contra la BD; queda
 * editable para que soporte la reasigne si el auto-match falla.
 */
model CarteraDetallado {
  id                 String        @id @default(cuid())
  consolidadoId      String
  tipoDocumento      TipoDocumento
  numeroDocumento    String
  nombreCompleto     String
  periodoCobro       String // "AAAA-MM"
  valorCobro         Decimal       @db.Decimal(15, 2)
  ibc                Decimal?      @db.Decimal(15, 2) // IBC reportado (solo algunos formatos)
  novedad            String? // IGE, NVL, etc. (texto libre)
  sucursalAsignadaId String?
  cotizanteId        String? // match con Cotizante en BD (opcional)
  estado             CarteraEstado @default(EN_CONCILIACION)
  observaciones      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  consolidado      CarteraConsolidado @relation(fields: [consolidadoId], references: [id], onDelete: Cascade)
  sucursalAsignada Sucursal?          @relation(fields: [sucursalAsignadaId], references: [id], onDelete: SetNull)
  cotizante        Cotizante?         @relation(fields: [cotizanteId], references: [id], onDelete: SetNull)
  gestiones        CarteraGestion[]

  @@index([consolidadoId])
  @@index([sucursalAsignadaId])
  @@index([cotizanteId])
  @@index([estado])
  @@index([numeroDocumento])
  // Sprint perf — bandeja /admin/administrativo/cartera filtra por
  // sucursalAsignadaId + estado y ordena por updatedAt; los KPIs del
  // dashboard agregan por mismo trío. Índice compuesto para soportar
  // ambos sin extra seq_scan cuando crezca la tabla.
  @@index([sucursalAsignadaId, estado, updatedAt(sort: Desc)])
  @@map("cartera_detallado")
}

/**
 * Bitácora de gestiones sobre una línea. Soporte y el aliado registran
 * sus acciones aquí; el enum `accionadaPor` distingue de qué lado viene.
 * Si la gestión cambia de estado, `nuevoEstado` lo captura para auditoría.
 */
model CarteraGestion {
  id           String              @id @default(cuid())
  detalladoId  String
  accionadaPor CarteraAccionadaPor
  nuevoEstado  CarteraEstado? // si la gestión promovió el estado
  descripcion  String
  userId       String?
  userName     String?
  createdAt    DateTime            @default(now())

  detallado CarteraDetallado @relation(fields: [detalladoId], references: [id], onDelete: Cascade)
  user      User?            @relation("CarterasGestionesUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([detalladoId])
  @@index([userId])
  @@map("cartera_gestion")
}

// ============================================================
// MÓDULO INCAPACIDADES (Administrativo radica · Soporte gestiona)
// ============================================================
// El aliado radica una incapacidad desde /admin/administrativo/incapacidades
// con los datos del cotizante + adjuntos. Soporte la procesa desde
// /admin/soporte/incapacidades y actualiza el estado. Todos los documentos
// se guardan bajo UPLOADS_DIR por 120 días; al día 121 se eliminan del
// disco pero queda el registro con el hash y metadatos (evidencia).

enum IncapacidadTipo {
  ENFERMEDAD_GENERAL
  LICENCIA_MATERNIDAD
  LICENCIA_PATERNIDAD
  ACCIDENTE_TRABAJO
  ACCIDENTE_TRANSITO_SOAT
}

/**
 * Estados de una incapacidad — flujo típico:
 * RADICADA              aliado envío formulario + documentos
 * EN_REVISION           soporte la esta revisando (puede pedir ajustes)
 * APROBADA              soporte validó, entidad pagará
 * PAGADA                el aliado / cotizante recibió el pago
 * RECHAZADA             la entidad la negó definitivamente
 * TRASLADO_A_JURIDICO   soporte detectó que necesita revisión legal
 *                       (impugnación, controversia con la entidad, etc.).
 *                       Caso aparece en bandeja Soporte/Jurídico.
 * EN_PROCESO_JURIDICO   el área jurídica tomó el caso y está gestionando
 *                       (envío de impugnación, espera de respuesta, etc.).
 *                       Solo el rol jurídico puede mover de vuelta a
 *                       APROBADA / PAGADA / RECHAZADA al cerrar.
 */
enum IncapacidadEstado {
  RADICADA
  EN_REVISION
  APROBADA
  PAGADA
  RECHAZADA
  TRASLADO_A_JURIDICO
  EN_PROCESO_JURIDICO
}

/**
 * Tipos de adjunto permitidos en una radicación. Se dividen en dos
 * grupos lógicos:
 *   - Médicos / administrativos (los 6 primeros) — los sube el aliado al
 *     radicar o soporte como respaldo del trámite normal.
 *   - Jurídicos (los 5 últimos) — solo se suben desde el flujo
 *     `confidencial=true` cuando el caso pasa al área legal. Cubren
 *     derechos de petición, tutelas, etc.
 *
 * El UI de cada flujo filtra qué subset mostrar, así no se mezclan
 * conceptualmente. La enum es plana para evitar dos relaciones distintas.
 */
enum IncapacidadDocumentoTipo {
  // --- Médicos / administrativos ---
  COPIA_CEDULA
  CERTIFICADO_INCAPACIDAD
  HISTORIA_CLINICA
  CERTIFICADO_BANCARIO
  AUTORIZACION_PAGO_TERCEROS
  FURIPS_SOAT
  // --- Jurídicos (confidencial=true) ---
  DERECHO_PETICION
  TUTELA
  DESACATO
  RESOLUCION
  OTRO_JURIDICO
}

/**
 * Quién ejecutó la gestión en la bitácora.
 *  SOPORTE   — gestión registrada por staff (ADMIN/SOPORTE) en la bandeja
 *              de soporte/incapacidades.
 *  ALIADO    — gestión registrada por aliado (responder pedido, anexar doc).
 *  JURIDICO  — gestión registrada en la bandeja Soporte/Jurídico por staff
 *              con rol jurídico. Permite distinguir en la bitácora qué
 *              gestiones son del proceso legal.
 */
enum IncapacidadAccionadaPor {
  SOPORTE
  ALIADO
  JURIDICO
}

/**
 * Radicación de incapacidad. Snapshots de empresa/entidades/fecha
 * afiliación al momento de radicar — si después cambian en la ficha
 * del cotizante, la incapacidad conserva lo que se reportó.
 */
model Incapacidad {
  id              String   @id @default(cuid())
  consecutivo     String   @unique // INC-000001
  fechaRadicacion DateTime @default(now())

  /**
   * Sucursal que radica (tenant owner).
   */
  sucursalId  String
  /**
   * Cotizante afectado — match por tipoDoc+numDoc al radicar.
   */
  cotizanteId String
  tipo        IncapacidadTipo

  // --- Fechas del período de incapacidad ---
  fechaInicio     DateTime
  fechaFin        DateTime
  diasIncapacidad Int

  // --- Snapshots de la afiliación al momento de radicar ---
  empresaPlanillaId         String? // Empresa (si dependiente)
  empresaPlanillaNombreSnap String? // nombre denormalizado
  epsId                     String?
  afpId                     String?
  arlId                     String?
  ccfId                     String?
  fechaAfiliacionSnap       DateTime? // fecha de afiliación del cotizante

  estado        IncapacidadEstado @default(RADICADA)
  observaciones String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  sucursal           Sucursal               @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  cotizante          Cotizante              @relation(fields: [cotizanteId], references: [id], onDelete: Restrict)
  empresaPlanilla    Empresa?               @relation("IncapacidadEmpresa", fields: [empresaPlanillaId], references: [id], onDelete: SetNull)
  eps                EntidadSgss?           @relation("IncapacidadEps", fields: [epsId], references: [id], onDelete: SetNull)
  afp                EntidadSgss?           @relation("IncapacidadAfp", fields: [afpId], references: [id], onDelete: SetNull)
  arl                EntidadSgss?           @relation("IncapacidadArl", fields: [arlId], references: [id], onDelete: SetNull)
  ccf                EntidadSgss?           @relation("IncapacidadCcf", fields: [ccfId], references: [id], onDelete: SetNull)
  createdBy          User?                  @relation("IncapacidadesCreadas", fields: [createdById], references: [id], onDelete: SetNull)
  documentos         IncapacidadDocumento[]
  gestiones          IncapacidadGestion[]
  movimientosDetalle MovimientoIncDetalle[]

  @@index([sucursalId])
  @@index([cotizanteId])
  @@index([estado])
  @@index([tipo])
  @@index([fechaRadicacion])
  // Sprint perf — bandeja /admin/administrativo/incapacidades y los
  // KPIs filtran por sucursalId + estado y ordenan por fechaRadicacion
  // desc. Patrón homogéneo en todos los queries de producción.
  @@index([sucursalId, estado, fechaRadicacion(sort: Desc)])
  @@map("incapacidades")
}

/**
 * Documento adjunto a una incapacidad. `archivoPath` es relativo a
 * UPLOADS_DIR. A los 120 días el archivo se elimina del disco y se
 * marca `eliminado=true` (el registro queda como evidencia).
 */
model IncapacidadDocumento {
  id                    String                   @id @default(cuid())
  incapacidadId         String
  tipo                  IncapacidadDocumentoTipo
  archivoPath           String // relativo a UPLOADS_DIR
  archivoHash           String // sha-256 hex
  archivoMime           String // ej. image/jpeg, application/pdf
  archivoSize           Int // bytes
  archivoNombreOriginal String // tal como lo subió el usuario
  /**
   * `true` cuando el archivo físico ya fue eliminado por retención.
   */
  eliminado             Boolean                  @default(false)
  eliminadoEn           DateTime?
  /**
   * Sprint Soporte reorg fase 2 — Quién subió el documento. Default
   * `ALIADO` para que los registros existentes (todos pre-feature)
   * queden marcados consistentemente con la realidad: hasta ahora solo
   * el aliado podía subir documentos al radicar. Cuando soporte
   * empiece a subir resoluciones EPS/respuestas oficiales, irán como
   * `SOPORTE`. Los documentos del flujo jurídico van como `JURIDICO`.
   */
  accionadaPor          IncapacidadAccionadaPor  @default(ALIADO)
  /**
   * Sprint Jurídico — `true` indica documento del proceso legal (carta
   * impugnación, comunicación oficial, dictamen, etc.). Cualquier usuario
   * staff puede VER que existe el documento (en el listado), pero solo
   * los que tienen el permiso `soporte.juridico_confidencial` (rol ADMIN
   * o RolCustom específico) pueden DESCARGARLO. Default `false` —
   * documentos del flujo regular (cédula, incapacidad, etc.) son
   * visibles para todo soporte.
   */
  confidencial          Boolean                  @default(false)
  /** Usuario que subió el archivo. NULL si el aliado aún no estaba autenticado en la sesión cuando se subió (no debería pasar, pero defensivo). */
  userId                String?
  createdAt             DateTime                 @default(now())

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id], onDelete: Cascade)
  user        User?       @relation("IncapacidadDocumentoUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([incapacidadId])
  @@index([tipo])
  @@index([eliminado])
  @@index([userId])
  @@map("incapacidad_documentos")
}

/**
 * Bitácora de gestiones sobre una incapacidad (aliado o soporte).
 */
model IncapacidadGestion {
  id            String                  @id @default(cuid())
  incapacidadId String
  accionadaPor  IncapacidadAccionadaPor
  nuevoEstado   IncapacidadEstado?
  descripcion   String
  userId        String?
  userName      String?
  createdAt     DateTime                @default(now())

  incapacidad Incapacidad @relation(fields: [incapacidadId], references: [id], onDelete: Cascade)
  user        User?       @relation("IncapacidadGestionesUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([incapacidadId])
  @@index([userId])
  @@map("incapacidad_gestion")
}

// =========================================================================
// Soporte · Afiliaciones — bandeja de solicitudes que genera el aliado
// cuando crea / reactiva / modifica una afiliación ACTIVA. El patrón sigue
// el módulo Incapacidades (documentos con retención 120d + bitácora de
// gestiones). Los disparos son automáticos desde actions.ts de base-datos.
// =========================================================================

/**
 * Evento que generó la solicitud. Una solicitud puede contener varios
 * disparos simultáneos (ej. una edición que cambia empresa + plan SGSS).
 */
enum SoporteAfTipoDisparo {
  NUEVA // creación de afiliación ACTIVA
  REACTIVACION // INACTIVA → ACTIVA
  CAMBIO_FECHA_INGRESO
  CAMBIO_EMPRESA
  CAMBIO_NIVEL_ARL
  CAMBIO_PLAN_SGSS
}

/**
 * Estados del flujo de atención de soporte.
 */
enum SoporteAfEstado {
  EN_PROCESO // default al recibirse del aliado
  PROCESADA // soporte validó y cerró
  RECHAZADA // soporte rechazó definitivamente
  NOVEDAD // soporte marcó "requiere ajuste del aliado"
}

/**
 * Quién ejecutó la gestión / subida de documento.
 *
 * BOT — gestión automática registrada por el worker del bot Colpatria
 *       cuando termina la afiliación ARL en el portal (Sprint Soporte
 *       reorg, 2026-04-27). Lleva el PDF descargado como soporte y
 *       aparece en la bitácora del modal con etiqueta diferenciada.
 */
enum SoporteAfAccionadaPor {
  SOPORTE
  ALIADO
  BOT
}

/**
 * Solicitud radicada automáticamente cuando un aliado crea/edita una
 * afiliación que queda en estado ACTIVA. Guarda snapshots antes/después
 * para que soporte vea qué cambió, y un consecutivo global SOP-AF-000001.
 */
model SoporteAfiliacion {
  id              String   @id @default(cuid())
  consecutivo     String   @unique // SOP-AF-000001
  fechaRadicacion DateTime @default(now()) // recibido + hora

  afiliacionId String
  cotizanteId  String
  sucursalId   String // desnormalizado para filtro rápido
  createdById  String? // aliado dueño que disparó

  disparos        SoporteAfTipoDisparo[]
  snapshotAntes   Json?
  snapshotDespues Json?

  // Snapshots ligeros para la tabla (evitan joins pesados)
  modalidadSnap  Modalidad
  planNombreSnap String?
  regimenSnap    Regimen?

  estado              SoporteAfEstado @default(EN_PROCESO)
  estadoObservaciones String?
  gestionadoPorId     String?
  gestionadoEn        DateTime?

  /**
   * Sprint Soporte reorg — usuario STAFF al que se le asignó la
   * solicitud para ejecutar tareas manuales (validación, llamadas, etc).
   * Se diferencia de `gestionadoPorId` (que es el último que cambió el
   * estado): la asignación es PROACTIVA (alguien decide quién atiende),
   * no reactiva. Cualquier ADMIN o SOPORTE puede asignar/reasignar.
   */
  asignadoAUserId String?

  periodoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  afiliacion    Afiliacion       @relation(fields: [afiliacionId], references: [id], onDelete: Restrict)
  cotizante     Cotizante        @relation(fields: [cotizanteId], references: [id], onDelete: Restrict)
  sucursal      Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  createdBy     User?            @relation("SoporteAfCreator", fields: [createdById], references: [id], onDelete: SetNull)
  gestionadoPor User?            @relation("SoporteAfGestor", fields: [gestionadoPorId], references: [id], onDelete: SetNull)
  asignadoA     User?            @relation("SoporteAfAsignado", fields: [asignadoAUserId], references: [id], onDelete: SetNull)
  periodo       PeriodoContable? @relation(fields: [periodoId], references: [id], onDelete: SetNull)

  documentos SoporteAfDocumento[]
  gestiones  SoporteAfGestion[]

  @@index([sucursalId, estado])
  @@index([periodoId])
  @@index([createdById])
  @@index([afiliacionId])
  @@index([cotizanteId])
  @@index([fechaRadicacion])
  @@index([asignadoAUserId])
  // Sprint perf — bandeja /admin/soporte/afiliaciones filtra por
  // estado y pagina por fechaRadicacion desc (take 500). Soporta
  // staff que ve todas las solicitudes sin filtro de sucursal.
  @@index([estado, fechaRadicacion(sort: Desc)])
  // Sprint perf — vista "mis tareas asignadas" del soportista filtra
  // por asignadoAUserId + estado.
  @@index([asignadoAUserId, estado])
  @@map("soporte_afiliacion")
}

/**
 * Documento adjunto a una solicitud (subido por el aliado al radicar o
 * por soporte al gestionar). Misma política de retención 120d que
 * incapacidades: se elimina el archivo pero el registro queda como
 * evidencia.
 */
model SoporteAfDocumento {
  id                    String                @id @default(cuid())
  soporteAfId           String
  accionadaPor          SoporteAfAccionadaPor
  descripcion           String? // etiqueta libre opcional
  archivoPath           String // relativo a UPLOADS_DIR
  archivoHash           String // sha-256 hex
  archivoMime           String
  archivoSize           Int
  archivoNombreOriginal String
  eliminado             Boolean               @default(false)
  eliminadoEn           DateTime?
  userId                String? // quien subió
  createdAt             DateTime              @default(now())

  soporteAf SoporteAfiliacion @relation(fields: [soporteAfId], references: [id], onDelete: Cascade)
  user      User?             @relation("SoporteAfDocUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([soporteAfId])
  @@index([eliminado])
  @@map("soporte_afiliacion_documentos")
}

/**
 * Bitácora de gestiones (aliado o soporte) sobre una solicitud.
 */
model SoporteAfGestion {
  id           String                @id @default(cuid())
  soporteAfId  String
  accionadaPor SoporteAfAccionadaPor
  nuevoEstado  SoporteAfEstado?
  descripcion  String
  userId       String?
  userName     String?
  createdAt    DateTime              @default(now())

  soporteAf SoporteAfiliacion @relation(fields: [soporteAfId], references: [id], onDelete: Cascade)
  user      User?             @relation("SoporteAfGestionUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([soporteAfId])
  @@index([userId])
  @@map("soporte_afiliacion_gestion")
}

// =========================================================================
// FINANZAS — Cobro Aliados + Movimientos Incapacidades + Detalle
// =========================================================================

// --- Cobro Aliados ---------------------------------------------------------

/**
 * Estados del ciclo de cobro al aliado.
 */
enum CobroAliadoEstado {
  PENDIENTE // generado, el aliado no ha pagado
  PAGADO // el aliado pagó — staff conciliado
  VENCIDO // pasó el día 15 sin pagar — sucursal bloqueada
  ANULADO // staff anuló (corrección / error de generación)
}

/**
 * Tipo de concepto en un cobro — determina el origen del ítem:
 * AFILIACION_PROCESADA  — cada SoporteAfiliacion con estado PROCESADA
 * en el período contable.
 * MENSUALIDAD          — cada Comprobante tipo RECIBO/CXC emitido en
 * el período (respeta la regla: si la afiliación
 * tiene retiro con duración ≤5 días no cobra).
 */
enum CobroAliadoConceptoTipo {
  AFILIACION_PROCESADA
  MENSUALIDAD
}

/**
 * Cobro mensual al aliado por uso de la plataforma.
 * Se genera automáticamente al cerrar el período contable (último día mes
 * 23:59). Plazo de pago: día 15 del mes siguiente. Día 16 → bloqueo.
 * Las tarifas vienen de Sucursal.tarifaOrdinario / tarifaResolucion y se
 * congelan al momento de generar (por si después cambian, el cobro queda
 * con los valores históricos).
 */
model CobroAliado {
  id            String    @id @default(cuid())
  consecutivo   String    @unique // CA-000001
  sucursalId    String
  periodoId     String
  fechaGenerado DateTime  @default(now())
  fechaLimite   DateTime // día 15 del mes siguiente (calculado al generar)
  fechaPagado   DateTime?
  /**
   * Si se bloqueó la sucursal por falta de pago, cuándo.
   */
  fechaBloqueo  DateTime?

  // Conteos del período (denormalizado para reporte rápido)
  cantAfiliaciones  Int @default(0)
  cantMensualidades Int @default(0)

  // Subtotales por tipo (denormalizado)
  valorAfiliaciones  Decimal @default(0) @db.Decimal(12, 2)
  valorMensualidades Decimal @default(0) @db.Decimal(12, 2)

  totalCobro Decimal @db.Decimal(12, 2)

  estado         CobroAliadoEstado @default(PENDIENTE)
  medioPagoId    String?
  referenciaPago String?
  observaciones  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sucursal  Sucursal        @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  periodo   PeriodoContable @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  medioPago MedioPago?      @relation(fields: [medioPagoId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("CobroAliadoCreator", fields: [createdById], references: [id], onDelete: SetNull)

  conceptos             CobroAliadoConcepto[]
  documentos            CobroAliadoDocumento[]
  // Sprint Efipay — historial de intentos de pago via pasarela. Un cobro
  // puede tener varios intentos (rechazo → reintento). El último APROBADA
  // es el que cuenta como pago efectivo.
  efipayTransacciones   EfipayTransaccion[]

  // Un solo cobro por sucursal + periodo — evita duplicados al re-generar.
  @@unique([sucursalId, periodoId])
  @@index([estado])
  @@index([fechaLimite])
  @@index([periodoId])
  @@map("cobro_aliado")
}

/**
 * Desglose línea a línea del cobro: cada afiliación procesada + cada
 * mensualidad facturada. Guarda la referencia al recurso origen (afiliacion
 * o comprobante) para trazabilidad.
 */
model CobroAliadoConcepto {
  id           String                  @id @default(cuid())
  cobroId      String
  tipo         CobroAliadoConceptoTipo
  descripcion  String? // texto libre (ej. "Mensualidad mayo — Juan Pérez")
  /**
   * FK informativo: afiliacionId o comprobanteId del registro origen.
   */
  referenciaId String?
  /**
   * Régimen aplicado (ORDINARIO/RESOLUCION) — determina qué tarifa usa.
   */
  regimen      Regimen?
  cantidad     Int                     @default(1)
  valorUnit    Decimal                 @db.Decimal(12, 2)
  subtotal     Decimal                 @db.Decimal(12, 2)

  cobro CobroAliado @relation(fields: [cobroId], references: [id], onDelete: Cascade)

  @@index([cobroId])
  @@index([tipo])
  @@map("cobro_aliado_concepto")
}

/**
 * Documentos soporte del cobro (comprobante de pago del aliado, recibos,
 * notas de ajuste). Misma forma que el resto de documentos del sistema.
 */
model CobroAliadoDocumento {
  id                    String   @id @default(cuid())
  cobroId               String
  archivoPath           String // relativo a UPLOADS_DIR
  archivoHash           String // sha-256 hex
  archivoMime           String
  archivoSize           Int
  archivoNombreOriginal String
  userId                String?
  createdAt             DateTime @default(now())

  cobro CobroAliado @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  user  User?       @relation("CobroAliadoDocUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([cobroId])
  @@map("cobro_aliado_documento")
}

// --- Movimientos Incapacidades --------------------------------------------

/**
 * Estados de un movimiento bancario.
 */
enum MovimientoIncEstado {
  PENDIENTE // recién importado, aún no se ha desglosado ni conciliado
  CONCILIADO // suma de sus detalles = valor total del movimiento
  ANULADO // staff lo anuló (error de importación, duplicado, etc.)
}

/**
 * Movimiento bancario — típicamente una consignación de una entidad
 * (EPS/ARL) al sistema por incapacidades pagadas. Se carga masivamente
 * desde Excel/PDF de extractos bancarios.
 */
model MovimientoIncapacidad {
  id            String              @id @default(cuid())
  consecutivo   String              @unique // MI-000001
  empresaId     String? // empresa planilla asociada (si se identifica al importar)
  /**
   * Sprint Soporte reorg — entidad SGSS de origen del depósito (solo
   * EPS y ARL hoy). En el modal de registro manual el usuario la
   * elige por autocomplete; en imports queda null hasta que soporte
   * lo asigne en la tabla. Reemplaza al uso libre de `concepto` para
   * casos estructurados (concepto sigue libre para # de autorización).
   */
  entidadSgssId String?
  fechaIngreso  DateTime // fecha del movimiento en el banco
  concepto      String // referencia/descripción del extracto
  valor         Decimal             @db.Decimal(14, 2)
  estado        MovimientoIncEstado @default(PENDIENTE)
  bancoOrigen   String? // "Bancolombia", "Davivienda", etc.
  /**
   * Hash del registro en el extracto — previene duplicados al re-importar.
   * Formato: sha256(banco|fecha|valor|concepto).
   */
  hashIdentidad String?             @unique
  observaciones String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa     Empresa?               @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  entidadSgss EntidadSgss?           @relation("MovIncEntidad", fields: [entidadSgssId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("MovIncCreator", fields: [createdById], references: [id], onDelete: SetNull)
  detalles    MovimientoIncDetalle[]

  @@index([estado])
  @@index([fechaIngreso])
  @@index([empresaId])
  @@index([entidadSgssId])
  @@map("movimiento_incapacidad")
}

// --- Detalle de Movimientos -----------------------------------------------

/**
 * Forma en que se liquida el pago de la incapacidad — campo legacy
 * (Sprint Soporte reorg deprecó este enum a favor de `MedioPagoFisico`).
 *
 * Lo mantenemos por compat con datos históricos. La UI nueva usa
 * `medioPago` (efectivo/transferencia) como reemplazo. A futuro se
 * puede dropear cuando se migren los datos viejos.
 */
enum MovimientoFormaPago {
  PAGO_COTIZANTE // se transfiere al cotizante directamente
  PAGO_ALIADO // se transfiere al aliado (él lo paga al cotizante)
  CRUCE_COBRO_ALIADO // se aplica al cobro pendiente del aliado
}

/**
 * Sprint Soporte reorg — Medio físico del pago. Reemplaza
 * `MovimientoFormaPago` (que era "destinatario") por algo más útil
 * para la operación contable.
 *
 * - EFECTIVO: el cotizante recibió el pago en caja / billete físico.
 * - TRANSFERENCIA: pago vía transferencia bancaria — requiere el
 *   `numeroTransaccion` para conciliar con el extracto.
 */
enum MedioPagoFisico {
  EFECTIVO
  TRANSFERENCIA
}

/**
 * Estado del detalle (registro individual dentro del movimiento).
 *
 * Sprint Soporte reorg — agregamos `DEVUELTA` para registrar pagos
 * que el banco rechazó / devolvió (cuenta cerrada, datos errados).
 */
enum MovimientoDetalleEstado {
  PENDIENTE
  EN_PROCESO
  PAGADA
  DEVUELTA
}

/**
 * Desglose individual de un movimiento bancario — un registro por cotizante
 * pagado dentro del depósito. Calcula retenciones automáticas:
 * retencion4x1000  = subtotal * 0.4%
 * retencionImpuesto = subtotal * 3.5%
 * totalPagar       = subtotal - retencion4x1000 - retencionImpuesto
 * Si se encuentra match por tipoDocumento+numeroDocumento, se asocia la
 * incapacidad correspondiente (SoporteIncapacidades).
 */
model MovimientoIncDetalle {
  id           String @id @default(cuid())
  movimientoId String

  // Datos del cotizante (snapshot — se preservan aunque luego cambien en BD)
  tipoDocumento   String
  numeroDocumento String
  nombreCompleto  String

  // FKs opcionales — se llenan si hay match en la base
  cotizanteId   String?
  incapacidadId String? // consecutivo de la incapacidad asociada
  sucursalId    String? // dueño aliado (se hereda de incapacidad.sucursalId)

  // Fechas de la incapacidad (copiadas al asociar; editable manualmente)
  fechaInicioInc DateTime?
  fechaFinInc    DateTime?

  // Montos
  subtotal          Decimal @db.Decimal(12, 2)
  retencion4x1000   Decimal @db.Decimal(12, 2) // 0.4% del subtotal
  retencionImpuesto Decimal @db.Decimal(12, 2) // 3.5% del subtotal
  totalPagar        Decimal @db.Decimal(12, 2) // subtotal - 4x1000 - impuesto

  // Pago — campo legacy. Era required, ahora opcional. Sprint Soporte
  // reorg: la nueva UX usa `medioPago` (efectivo/transferencia) en su
  // lugar; este campo queda para los registros viejos.
  formaPago MovimientoFormaPago?

  /**
   * Sprint Soporte reorg — medio físico del pago al cotizante.
   * Si `TRANSFERENCIA`, `numeroTransaccion` es obligatorio (validación
   * en server action). Si `EFECTIVO`, opcional.
   *
   * Nota: el enum se llama `MedioPagoFisico` (no `MedioPago`) porque
   * ya existe un modelo `MedioPago` que es un catálogo distinto
   * (medios de pago de la sucursal).
   */
  medioPago MedioPagoFisico?

  /**
   * Sprint Soporte reorg — referencia bancaria del pago. Obligatorio
   * cuando `medioPago=TRANSFERENCIA`, opcional para EFECTIVO.
   */
  numeroTransaccion String?

  estado    MovimientoDetalleEstado @default(PENDIENTE)
  fechaPago DateTime?
  /**
   * Empresa planilla usada como "pagada mediante".
   */
  pagadoConEmpresaId String?
  observaciones      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimiento       MovimientoIncapacidad @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  cotizante        Cotizante?            @relation(fields: [cotizanteId], references: [id], onDelete: SetNull)
  incapacidad      Incapacidad?          @relation(fields: [incapacidadId], references: [id], onDelete: SetNull)
  sucursal         Sucursal?             @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  pagadoConEmpresa Empresa?              @relation("MovDetallePagadoCon", fields: [pagadoConEmpresaId], references: [id], onDelete: SetNull)

  documentos MovimientoDetalleDocumento[]

  @@index([movimientoId])
  @@index([estado])
  @@index([numeroDocumento])
  @@index([sucursalId])
  @@index([incapacidadId])
  @@map("movimiento_inc_detalle")
}

/**
 * Soportes de pago individual (comprobante de transferencia, etc.).
 */
model MovimientoDetalleDocumento {
  id                    String   @id @default(cuid())
  detalleId             String
  archivoPath           String
  archivoHash           String
  archivoMime           String
  archivoSize           Int
  archivoNombreOriginal String
  userId                String?
  createdAt             DateTime @default(now())

  detalle MovimientoIncDetalle @relation(fields: [detalleId], references: [id], onDelete: Cascade)
  user    User?                @relation("MovDetDocUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([detalleId])
  @@map("movimiento_det_documento")
}

// =========================================================================
// NOTIFICACIONES — bandeja in-app
// =========================================================================
//
// Sistema simple de mensajes dirigidos. Una notificación puede apuntar a:
//   - Un usuario específico (`destinoUserId`)
//   - Todos los usuarios de un rol (`destinoRole`) — útil para staff
//   - Todos los usuarios de una sucursal (`destinoSucursalId`) — para
//     llegar al ALIADO_OWNER y ALIADO_USER de esa sucursal
//
// Al menos uno de los 3 debe estar seteado. La query de "no leídas"
// combina los 3 con OR.
//
// `leidaEn` se setea cuando el usuario hace click. La regla de "leída"
// se evalúa por usuario — para notificaciones por rol/sucursal, se mide
// con un set adicional `NotificacionLeida` (user × notificacion).

enum NotificacionTipo {
  /**
   * Soporte: el aliado creó/modificó/reactivó una afiliación ACTIVA.
   */
  SOPORTE_NUEVA_AFILIACION
  /**
   * Soporte: el aliado radicó una nueva incapacidad.
   */
  SOPORTE_NUEVA_INCAPACIDAD
  /**
   * Soporte: el aliado registró una gestión sobre una línea de cartera.
   */
  SOPORTE_RESPUESTA_CARTERA
  /**
   * Aliado: soporte marcó una línea como MORA_REAL o CARTERA_REAL.
   */
  ALIADO_CARTERA_ASIGNADA
  /**
   * Aliado: soporte registró una gestión sobre una incapacidad de la sucursal.
   */
  ALIADO_GESTION_INCAPACIDAD
  /**
   * Sprint Soporte reorg fase 2 — Soporte: el aliado agregó una nota a
   * la bitácora de una incapacidad. Antes solo se enteraban refrescando
   * la página manualmente.
   */
  SOPORTE_NOTA_INCAPACIDAD
  /**
   * Sprint Chat · notif bandeja — un participante de la conversación
   * recibió un mensaje y NO lo había abierto en los últimos 2 min
   * (chat "frío"). Lleva al user al widget abierto en esa conv.
   * Dedup: no se emite otra notif del mismo (user, conversacion) si
   * hay una de hace <5 min.
   */
  CHAT_MENSAJE_NUEVO
  /**
   * Sprint Chat · menciones — alguien escribió @<nombre> y este user es
   * el referido. Se emite una notif por cada mención, sin dedup ni
   * umbral frío: una mención es una llamada directa.
   */
  CHAT_MENCION
}

model Notificacion {
  id   String           @id @default(cuid())
  tipo NotificacionTipo

  // Targeting — al menos uno se llena.
  destinoUserId     String?
  destinoRole       Role?
  destinoSucursalId String?

  titulo    String
  mensaje   String
  /**
   * Ruta a la que llevar al usuario al hacer click ("/admin/...").
   */
  href      String?
  /**
   * Datos extra (consecutivo, IDs, etc.).
   */
  metadatos Json?

  createdAt DateTime @default(now())

  destinoUser     User?                 @relation("NotificacionDestino", fields: [destinoUserId], references: [id], onDelete: Cascade)
  destinoSucursal Sucursal?             @relation("NotificacionSucursal", fields: [destinoSucursalId], references: [id], onDelete: Cascade)
  lecturas        NotificacionLectura[]

  @@index([destinoUserId, createdAt])
  @@index([destinoRole, createdAt])
  @@index([destinoSucursalId, createdAt])
  @@map("notificaciones")
}

/**
 * Marca una notificación como leída por un usuario específico. Permite
 * que las notificaciones por rol o sucursal mantengan estado de lectura
 * por usuario sin duplicar la fila origen.
 */
model NotificacionLectura {
  id             String   @id @default(cuid())
  notificacionId String
  userId         String
  leidaEn        DateTime @default(now())

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, userId])
  @@index([userId])
  @@map("notificacion_lectura")
}

// =========================================================================
// CRON RUN — registro de ejecuciones de jobs programados (Sprint 7.4)
// =========================================================================
//
// Cada vez que un job de GitHub Actions corre, el comando CLI registra
// su ejecución acá: cuándo arrancó, cuánto duró, si terminó OK o falló,
// y un resumen libre. Esto permite:
//
//   - Detectar si un cron MURIÓ silencioso (sin run reciente) — el
//     status page (Sprint 7.3) muestra alerta visual si el último run
//     fue hace más del intervalo esperado.
//   - Auditar histórico: cuántas filas borró el job de retención el mes
//     pasado, cuánto tomó.
//   - Diagnosticar fallos: el `error` queda al lado del `output` para
//     reconstruir qué pasó sin abrir GitHub Actions.

enum CronRunStatus {
  RUNNING
  OK
  ERROR
}

model CronRun {
  id         String        @id @default(cuid())
  /**
   * Nombre del job. Convención: kebab-case, mismo que el archivo
   * workflow YAML sin la extensión. Ej.: "retention-daily",
   * "auditoria-purge-monthly", "uploads-cleanup-weekly".
   */
  jobName    String
  status     CronRunStatus @default(RUNNING)
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  /**
   * Duración real en ms. Se rellena al finalizar.
   */
  durationMs Int?
  /**
   * Resumen humano breve: "120 archivos limpiados", "0 candidatos",
   * "falló al conectar a S3".
   */
  output     String?
  /**
   * Stack trace o mensaje de error si status=ERROR.
   */
  error      String?

  // Indexes pensados para los reportes del status page:
  //   - "último run de cada job" → jobName + startedAt desc
  //   - retención: borramos runs viejos por createdAt
  @@index([jobName, startedAt])
  @@index([startedAt])
  @@map("cron_runs")
}

// =========================================================================
// BOT COLPATRIA ARL (Sprint 8)
// =========================================================================
//
// Automatización del portal Colpatria ARL: cuando un aliado crea una
// afiliación nueva o reactiva una INACTIVA→ACTIVA con modalidad
// DEPENDIENTE y la empresa tiene `colpatriaActivo=true`, se crea un
// `ColpatriaAfiliacionJob` con status PENDING. Un worker Playwright
// (apps/bot-colpatria) los procesa periódicamente: login → navega al
// formulario → llena los campos → submit → descarga PDF de soporte → lo
// asocia a la afiliación.
//
// `ColpatriaSesion` cachea las cookies de sesión del portal por empresa
// para evitar 1 login por cada afiliación (con 50–70 al día sería
// ruidoso para Colpatria y aumentaría riesgo de bloqueo).

/**
 * Sesión activa con el portal Colpatria ARL para una empresa. Una sola
 * fila por empresa (relación 1:1). Los cookies son JSON encriptado con
 * la misma clave `COLPATRIA_ENC_KEY` que protege el password.
 */
model ColpatriaSesion {
  id         String    @id @default(cuid())
  empresaId  String    @unique
  /**
   * Cookies serializadas (JSON Playwright storageState), encriptadas.
   */
  cookiesEnc String
  /**
   * Cuándo se creó la sesión — para detectar sesiones muy viejas.
   */
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /**
   * Estimación de cuándo va a expirar la sesión en el portal. Si es
   * null o ya pasó, el worker hace login fresco antes de procesar.
   */
  expiraEn   DateTime?

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("colpatria_sesiones")
}

enum ColpatriaJobStatus {
  /**
   * Job creado pero el worker aún no lo agarró.
   */
  PENDING
  /**
   * Worker procesando ahora — locked para evitar doble ejecución.
   */
  RUNNING
  /**
   * Procesado OK, PDF descargado y guardado.
   */
  SUCCESS
  /**
   * Falló de forma definitiva (no reintentar automático). El operador
   * decide si reintentar manualmente.
   */
  FAILED
  /**
   * Falló por causa transitoria (timeout, sesión expirada, captcha
   * inesperado). Se reintenta automáticamente hasta `MAX_INTENTOS`.
   */
  RETRYABLE
}

/**
 * Job que el bot Colpatria debe procesar.
 * Reglas clave:
 * - Una afiliación puede tener varios jobs si los anteriores fallaron
 * y se reintenta — `intento` los distingue.
 * - El `payload` es un snapshot del estado al momento de crear el job.
 * Si la afiliación cambia después, el job sigue con lo que tenía —
 * el operador decide si crear uno nuevo.
 * - `screenshotsPaths` guarda paths relativos al UPLOADS_DIR donde el
 * worker dejó capturas de cada paso (login, form llenado, submit,
 * resultado). Útil para diagnosticar fallos.
 */
model ColpatriaAfiliacionJob {
  id               String             @id @default(cuid())
  afiliacionId     String
  empresaId        String
  status           ColpatriaJobStatus @default(PENDING)
  /**
   * Intento N de M. 1 para el primer job, 2+ si se reintentó.
   */
  intento          Int                @default(1)
  /**
   * Snapshot de los datos de la afiliación al momento de crear el
   * job. Lo que el bot le pasa al portal.
   */
  payload          Json
  /**
   * Cuándo el worker arrancó este intento.
   */
  startedAt        DateTime?
  /**
   * Cuándo el worker terminó (OK o falló).
   */
  finishedAt       DateTime?
  /**
   * Duración total en ms.
   */
  durationMs       Int?
  /**
   * Path al PDF descargado del portal (relativo a UPLOADS_DIR), null
   * hasta que el job termine en SUCCESS.
   */
  pdfPath          String?
  /**
   * Sprint 8.5.C — política de retención. Cuando el cron de limpieza
   * borra el archivo del filesystem (default 3 días después de creado),
   * marca este timestamp y deja `pdfPath` intacto como evidencia
   * histórica. Lecturas posteriores del PDF retornan 410 Gone.
   *
   * Si null + pdfPath presente → archivo aún existe en disco.
   * Si fechado → archivo ya borrado, solo queda metadata.
   */
  pdfArchivedAt    DateTime?
  /**
   * Array JSON de paths a screenshots por paso.
   */
  screenshotsPaths Json?
  /**
   * Mensaje de error humano si falló.
   */
  error            String?
  /**
   * Stack/payload extra para diagnóstico.
   */
  errorDetalle     Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  afiliacion Afiliacion @relation(fields: [afiliacionId], references: [id], onDelete: Cascade)
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([afiliacionId])
  @@index([empresaId, status])
  @@map("colpatria_afiliacion_jobs")
}

// =============================================================================
// Sprint 8.6 — Certificado de afiliación vigente (on-demand, sin retención)
// =============================================================================
// El usuario solicita el certificado desde la UI; el bot lo descarga del
// portal AXA y lo entrega UNA vez. Se borra el archivo apenas se sirve
// (campo `entregadoAt`). No se conservan históricos: cada solicitud crea
// un job nuevo y descarga un certificado fresco.

model ColpatriaCertificadoJob {
  id              String             @id @default(cuid())
  afiliacionId    String
  empresaId       String
  /// User que pidió el certificado (para auditoría y permisos).
  requestedById   String
  status          ColpatriaJobStatus @default(PENDING)
  intento         Int                @default(1)
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  /// Path al PDF descargado (relativo a UPLOADS_DIR). Se borra al
  /// servirlo; queda null tras `entregadoAt`.
  pdfPath         String?
  /// Cuando el endpoint sirvió el PDF al usuario y borró el archivo.
  /// Si null + status SUCCESS → PDF aún disponible para descarga.
  /// Si fechado → ya entregado, no se vuelve a servir (que pida otro).
  entregadoAt     DateTime?
  error           String?
  errorDetalle    Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  afiliacion  Afiliacion @relation(fields: [afiliacionId], references: [id], onDelete: Cascade)
  empresa     Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("ColpatriaCertSolicitante", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([afiliacionId])
  @@index([empresaId, status])
  @@index([requestedById])
  @@map("colpatria_certificado_jobs")
}

// =============================================================================
// PQRS — Peticiones, Quejas, Reclamos, Sugerencias y Felicitaciones
// =============================================================================
// Se reciben desde la landing pública (sin autenticación) y se gestionan en
// el módulo /admin/soporte/juridico → tab "PQRS". Plazos legales aplicados:
//   - PETICION (información)    → 10 días hábiles  (Ley 1755 de 2015)
//   - QUEJA / RECLAMO            → 15 días hábiles  (Ley 1755 / Ley 1480)
//   - SUGERENCIA / FELICITACION  → sin plazo legal (informativo, 30 días)
//
// El consecutivo PQRS-000001 se genera con secuencia SQL `pqrs_consecutivo_seq`
// (mismo patrón que Incapacidad). Migración de creación de la secuencia se
// genera junto con esta tabla.

enum PqrsTipo {
  PETICION // información, copias, consulta
  QUEJA // manifestación de inconformidad
  RECLAMO // exigencia de derecho
  SUGERENCIA // propuesta de mejora
  FELICITACION // reconocimiento positivo
}

enum PqrsEstado {
  RECIBIDA // default — recién creada por el solicitante
  EN_TRAMITE // staff la tomó y está trabajando en ella
  RESPONDIDA // staff envió respuesta formal
  CERRADA // ciclo terminado satisfactoriamente
  RECHAZADA // no procede / fuera de competencia
}

/// Quién subió un documento adjunto a una PQRS.
///   SOLICITANTE — adjunto cargado por el ciudadano al crear la PQRS desde la landing.
///   ADMIN       — adjunto cargado por staff al gestionar/responder.
enum PqrsDocOrigen {
  SOLICITANTE
  ADMIN
}

model Pqrs {
  id          String     @id @default(cuid())
  consecutivo String     @unique // PQRS-000001
  tipo        PqrsTipo
  estado      PqrsEstado @default(RECIBIDA)

  // Datos del solicitante (capturados en el form público — sin auth)
  tipoDocumento     String // CC | CE | NIT | PAS | TI | RC | NIP
  numeroDocumento   String
  nombres           String
  apellidos         String?
  email             String
  telefono          String
  empresaNombre     String? // opcional — solo cuando representa empresa

  asunto      String  @db.VarChar(200)
  descripcion String  @db.Text

  // Metadata técnica para auditoría / detección de spam
  ipAddress String?
  userAgent String?

  // Plazos
  fechaLimite   DateTime // calculada al crear según tipo (10/15/30 días hábiles)
  recibidaEn    DateTime @default(now())
  respondidaEn  DateTime?
  cerradaEn     DateTime?

  // Respuesta formal del staff
  respuesta       String? @db.Text
  respondidoById  String?
  respondidoBy    User?   @relation("PqrsRespondidoBy", fields: [respondidoById], references: [id], onDelete: SetNull)

  // Notificaciones — tracking de cuándo se enviaron (por ahora solo log,
  // cuando se integre Resend/Twilio se llenan estos campos al envío real)
  notificadoEmailEn    DateTime?
  notificadoWhatsappEn DateTime?

  // Vínculo opcional a una incapacidad existente (cuando la PQRS sea sobre
  // un caso ya radicado). Útil para que el área legal cruce información.
  relatedIncapacidadId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gestiones  PqrsGestion[]
  documentos PqrsDocumento[]

  @@index([estado])
  @@index([tipo])
  @@index([numeroDocumento])
  @@index([recibidaEn])
  @@index([fechaLimite])
  @@map("pqrs")
}

/// Bitácora de gestiones sobre una PQRS — cada cambio de estado, nota
/// interna, asignación o respuesta queda como evento inmutable.
model PqrsGestion {
  id          String      @id @default(cuid())
  pqrsId      String
  descripcion String      @db.Text
  nuevoEstado PqrsEstado? // null cuando es solo nota interna
  userId      String?
  userName    String? // denormalizado para preservar nombre incluso si el user se elimina
  createdAt   DateTime    @default(now())

  pqrs Pqrs  @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  user User? @relation("PqrsGestionUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([pqrsId, createdAt])
  @@map("pqrs_gestiones")
}

/// Documentos adjuntos a una PQRS. Pueden ser cargados por el solicitante
/// al crear la PQRS o por el staff al responder/gestionar.
/// Almacenamiento idéntico al patrón de IncapacidadDocumento — relativo a
/// UPLOADS_DIR. Retención: 120 días en disco, después se marca eliminado.
model PqrsDocumento {
  id                    String        @id @default(cuid())
  pqrsId                String
  archivoPath           String
  archivoHash           String
  archivoMime           String
  archivoSize           Int
  archivoNombreOriginal String
  origen                PqrsDocOrigen
  eliminado             Boolean       @default(false)
  eliminadoEn           DateTime?
  userId                String? // null cuando origen=SOLICITANTE (no hay sesión)
  createdAt             DateTime      @default(now())

  pqrs Pqrs  @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  user User? @relation("PqrsDocUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([pqrsId])
  @@index([origen])
  @@index([eliminado])
  @@map("pqrs_documentos")
}

// =========================================================================
// SECTION: PASARELA EFIPAY — pagos de aliados
// =========================================================================
//
// Sprint Efipay (2026-05): Integración con la pasarela Efipay para que el
// aliado pague su `CobroAliado` mensual desde el portal sin gestión
// manual de staff.
//
// Flujo:
//   1. Aliado pulsa "Pagar con Efipay" sobre un CobroAliado PENDIENTE/VENCIDO
//   2. Server action calcula sobrecosto (1% sobre totalCobro), llama
//      `POST https://<base>/api/v1/payment/generate-payment` con el
//      consecutivo del cobro como referencia.
//   3. Persiste `EfipayTransaccion` con estado PENDIENTE y la URL de
//      checkout que devolvió Efipay.
//   4. Aliado se redirige al checkout de Efipay → completa el pago.
//   5. Efipay invoca `POST /api/efipay/webhook` con el resultado. El handler
//      verifica firma HMAC-SHA256, busca la trx por payment_id, actualiza
//      su estado y, si es APROBADA, marca el `CobroAliado` como PAGADO.
//
// Una sucursal puede tener varios intentos por cobro (rechazo + reintento).
// El último APROBADA es el que cuenta.

/// Estados de una transacción Efipay desde nuestra perspectiva.
///   PENDIENTE  — creada, esperando que el aliado pague o recibir webhook
///   APROBADA   — Efipay confirmó el pago (webhook con status approved)
///   RECHAZADA  — la pasarela rechazó (tarjeta declinada, PSE cancelado, etc.)
///   EXPIRADA   — pasó la limit_date sin completar el pago
///   ERROR      — falló la creación del pago en Efipay (mantiene contexto)
enum EfipayEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
  EXPIRADA
  ERROR
}

/// Intento de pago via Efipay sobre un CobroAliado. Cada click en
/// "Pagar con Efipay" crea una nueva fila — los rechazos quedan en historial.
model EfipayTransaccion {
  id               String       @id @default(cuid())
  cobroAliadoId    String
  /// UUID que devuelve Efipay al crear el pago. Único en su sistema.
  /// Llega también en el webhook → es la clave para correlacionar.
  efipayPaymentId  String?      @unique
  /// El consecutivo del CobroAliado (CA-000001) — viaja como reference[0]
  /// hacia Efipay para identificar la transacción del lado nuestro.
  referencia       String
  /// Monto base (== totalCobro del CobroAliado al momento del intento).
  montoBase        Decimal      @db.Decimal(12, 2)
  /// Sobrecosto cobrado al aliado para mitigar la comisión Efipay (1% del
  /// montoBase). Se calcula al crear, queda congelado.
  sobrecosto       Decimal      @db.Decimal(12, 2)
  /// Lo que efectivamente se le cobra al aliado (montoBase + sobrecosto).
  /// Es el `amount` enviado a Efipay.
  montoCobrado     Decimal      @db.Decimal(12, 2)
  /// URL de checkout devuelta por Efipay para redirigir al aliado.
  urlCheckout      String?
  estado           EfipayEstado @default(PENDIENTE)
  /// Mensaje de error o motivo de rechazo (texto libre devuelto por Efipay).
  motivo           String?
  /// Payload crudo del último webhook recibido — útil para debugging y
  /// para re-procesar si la lógica cambia. JSON.
  webhookPayload   Json?
  webhookRecibidoEn DateTime?
  /// Cuántas veces Efipay nos llamó al webhook (debe ser 1 o, si fallamos,
  /// hasta 3 según su política de reintentos).
  intentosWebhook  Int          @default(0)
  iniciadaPorId    String?
  iniciadaEn       DateTime     @default(now())
  aprobadaEn       DateTime?
  rechazadaEn      DateTime?
  expiradaEn       DateTime?
  updatedAt        DateTime     @updatedAt

  cobro       CobroAliado @relation(fields: [cobroAliadoId], references: [id], onDelete: Cascade)
  iniciadaPor User?       @relation("EfipayTrxIniciadaPor", fields: [iniciadaPorId], references: [id], onDelete: SetNull)

  @@index([cobroAliadoId])
  @@index([estado])
  @@index([referencia])
  @@map("efipay_transaccion")
}

// =========================================================================
// MÓDULO REPORTE INTERNO DE ACCIDENTES E INCIDENTES DE TRABAJO (Reporte AT)
// El aliado radica un reporte desde /admin/administrativo/reporte-at con
// los datos del trabajador + hechos + causas. Soporte lo procesa desde
// /admin/soporte/reporte-at y actualiza el estado. Datos del trabajador
// guardados como snapshot (texto) para preservar el reporte tal como se
// radicó aunque el cotizante se actualice después.
// =========================================================================

enum ReporteATEstado {
  RADICADO
  EN_REVISION
  CERRADO
  ANULADO
}

enum ReporteATCausa {
  IMPRUDENCIA_PROPIA
  IMPRUDENCIA_OTROS
  FALTA_INSTRUCCIONES
  POCA_EXPERIENCIA
  MEDIDAS_INADECUADAS
  RIESGOS_PROPIOS
  OTROS
}

enum ReporteATAccionadaPor {
  SOPORTE
  ALIADO
}

/**
 * Radicación interna de accidente / incidente de trabajo. El formulario
 * lo diligencia el aliado (Administrativo) y soporte gestiona los
 * estados. `tipoDocumento` se guarda como String para no acoplarse al
 * enum global TipoDocumento (el formato AT acepta CC/CE/PEP/PPT/TI).
 * `partesCuerpo` se guarda como JSON con la forma:
 *   [{ parte: "Brazo", lateralidad: "DERECHA" | "IZQUIERDA" | "AMBAS" | "NA" }]
 */
model ReporteAccidenteTrabajo {
  id              String   @id @default(cuid())
  consecutivo     String   @unique // RAT-000001
  fechaRadicacion DateTime @default(now())

  /** Sucursal dueña del reporte (tenant). */
  sucursalId  String
  /** Cotizante afectado — opcional, link por tipoDoc+numDoc al radicar. */
  cotizanteId String?

  // ===== Datos del accidente =====
  /** Fecha del accidente (sólo fecha, sin tz). */
  fechaAccidente        DateTime
  /** Día de la semana del accidente — derivado al guardar. */
  diaSemanaAccidente    String?
  /** Hora del accidente en formato HH:mm (24h). */
  horaAccidente         String
  /** Hora de inicio de la jornada laboral del día del accidente. */
  horaInicioJornada     String
  /** Lugar (área y sección) donde ocurrió. */
  lugar                 String
  ciudadAccidente       String
  departamentoAccidente String

  // ===== Datos del trabajador (snapshot) =====
  trabajadorNombre           String
  trabajadorTipoDoc          String // CC | CE | PEP | PPT | TI
  trabajadorNumeroDoc        String
  trabajadorFondoPension     String?
  trabajadorEps              String?
  trabajadorCargo            String
  /** Tiempo de experiencia en el cargo, expresado en meses. */
  trabajadorExperienciaMeses Int?
  trabajadorTelefono         String?
  trabajadorDireccion        String?
  trabajadorCiudadResidencia String?
  trabajadorEstadoCivil      String?
  trabajadorEdad             Int?

  // ===== Empresa o razón social afiliada =====
  empresaRazonSocial String
  empresaNit         String

  // ===== Hechos =====
  hechosQueOcurrio  String
  hechosCuandoDonde String
  hechosComoOcurrio String

  // ===== Causas marcadas por el aliado =====
  causas      ReporteATCausa[]
  causasOtros String?

  /** Partes del cuerpo afectadas con su lateralidad. JSON. */
  partesCuerpo Json

  // ===== Responsable(s) del reporte =====
  responsableNombre    String
  responsableTelefono  String
  responsableCorreo    String

  responsable2Nombre   String?
  responsable2Telefono String?
  responsable2Correo   String?

  /** Correo del trabajador para notificación / firma. */
  trabajadorCorreoFirma String?

  /** Fecha en que el aliado elaboró el reporte (puede diferir del radicado). */
  fechaElaboracion DateTime

  estado        ReporteATEstado @default(RADICADO)
  observaciones String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sucursal   Sucursal             @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  cotizante  Cotizante?           @relation(fields: [cotizanteId], references: [id], onDelete: SetNull)
  createdBy  User?                @relation("ReporteATCreator", fields: [createdById], references: [id], onDelete: SetNull)
  gestiones  ReporteATGestion[]
  documentos ReporteATDocumento[]

  @@index([sucursalId])
  @@index([cotizanteId])
  @@index([estado])
  @@index([fechaRadicacion])
  @@index([sucursalId, estado, fechaRadicacion(sort: Desc)])
  @@map("reporte_at")
}

/**
 * Tipos de documento adjunto en un reporte AT. FURAT (Formato Único de
 * Reporte de Accidente de Trabajo) es el más común — soporte lo carga
 * cuando la ARL emite el formato oficial. La enum es plana para permitir
 * extender después (FURIPS, dictamen, etc.) sin migración estructural.
 */
enum ReporteATDocumentoTipo {
  FURAT
  OTRO
}

/**
 * Documento adjunto a un reporte AT. Política de retención corta:
 * 30 días desde createdAt, después se borra el archivo físico y queda
 * el registro como evidencia (`eliminado=true`). El soporte FURAT es
 * operativo, no requiere conservación a largo plazo.
 */
model ReporteATDocumento {
  id                    String                 @id @default(cuid())
  reporteAtId           String
  tipo                  ReporteATDocumentoTipo
  archivoPath           String // relativo a UPLOADS_DIR
  archivoHash           String // sha-256 hex
  archivoMime           String
  archivoSize           Int
  archivoNombreOriginal String
  /** `true` cuando el archivo físico ya fue eliminado por retención (30 días). */
  eliminado             Boolean                @default(false)
  eliminadoEn           DateTime?
  userId                String?
  createdAt             DateTime               @default(now())

  reporteAt ReporteAccidenteTrabajo @relation(fields: [reporteAtId], references: [id], onDelete: Cascade)
  user      User?                   @relation("ReporteATDocumentoUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([reporteAtId])
  @@index([tipo])
  @@index([eliminado])
  @@index([userId])
  @@map("reporte_at_documentos")
}

/** Bitácora de gestiones (cambios de estado, observaciones) sobre un reporte AT. */
model ReporteATGestion {
  id           String                @id @default(cuid())
  reporteAtId  String
  accionadaPor ReporteATAccionadaPor
  nuevoEstado  ReporteATEstado?
  descripcion  String
  userId       String?
  userName     String?
  createdAt    DateTime              @default(now())

  reporteAt ReporteAccidenteTrabajo @relation(fields: [reporteAtId], references: [id], onDelete: Cascade)
  user      User?                   @relation("ReporteATGestionUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([reporteAtId])
  @@index([userId])
  @@map("reporte_at_gestion")
}

// =================================================================
// Sprint Chat interno — mensajería entre staff y aliados (DM/grupos).
// =================================================================
//
// Diseño v1:
//   - DM: 1-a-1 entre dos users. Modelado igual que un grupo con dos
//     participantes — simplifica queries.
//   - GRUPO: N usuarios, requiere `nombre`. Cualquiera puede ser ADMIN
//     del grupo (para invitar/echar miembros) — el creador empieza como
//     ADMIN; los demás como MIEMBRO.
//   - Polling: el cliente refresca lista de conversaciones y mensajes de
//     la activa cada 10-15s. No hay SSE/WS por ahora.
//   - `lastReadAt` por participante para calcular unread count.
//   - `ultimoMensajeAt` denormalizado en Conversacion para ordenar la
//     lista sin un JOIN al último mensaje.
//
// Las reglas de quién puede chatear con quién viven en la capa de
// aplicación (lib/chat/elegibles.ts), no en BD: la matriz cambia con
// frecuencia (sprint reorg) y no queremos migraciones por eso.

enum ConversacionTipo {
  DM
  GRUPO
}

enum ConversacionParticipanteRol {
  MIEMBRO
  ADMIN
}

/// Sprint Chat · cierre+rating — una conversación puede estar ABIERTA
/// (composer activo, llegan mensajes) o CERRADA (read-only, dispara
/// dialog de calificación al participante no-staff). Se cierra por
/// botón explícito o por inactividad (30 min sin mensajes).
enum ConversacionEstado {
  ABIERTA
  CERRADA
}

model Conversacion {
  id              String             @id @default(cuid())
  tipo            ConversacionTipo
  /// Requerido en GRUPO, null en DM. Para DMs el cliente arma el título
  /// con el nombre del otro participante.
  nombre          String?
  createdById     String
  /// Denormalizado: timestamp del último mensaje. Permite ordenar la
  /// lista de conversaciones por actividad sin JOIN. Lo actualiza la
  /// server action `enviarMensaje` dentro de la misma transacción.
  ultimoMensajeAt DateTime?
  /// Sprint Chat · cierre+rating — estado actual de la conversación.
  estado          ConversacionEstado @default(ABIERTA)
  /// Cuándo se cerró (cualquier transición ABIERTA → CERRADA).
  cerradaAt       DateTime?
  /// Quién la cerró. NULL cuando el cierre fue por inactividad.
  cerradaPorUserId String?
  cerradaPorInactividad Boolean      @default(false)
  /// Contador de ciclos de cierre. Cada vez que se reabre se incrementa
  /// (cierre #1, cierre #2, ...). Se usa como clave para que la misma
  /// conversación pueda recibir múltiples calificaciones a lo largo del
  /// tiempo — una por aliado por ciclo. v1 arranca en 1 al crear.
  ciclo           Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy        User                        @relation("ConversacionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cerradaPor       User?                       @relation("ConversacionCerradaPor", fields: [cerradaPorUserId], references: [id], onDelete: SetNull)
  participantes    ConversacionParticipante[]
  mensajes         Mensaje[]
  calificaciones   ConversacionCalificacion[]

  @@index([ultimoMensajeAt(sort: Desc)])
  @@index([estado, ultimoMensajeAt])
  @@map("conversaciones")
}

/// Sprint Chat · calificaciones — el aliado puntea el soporte recibido
/// al cerrarse la conversación. Solo participan roles NO-STAFF como
/// "calificadores"; el modelo no fuerza ese check (vive en la app).
/// La nota es a la conversación entera (si había varios staff, es "al
/// equipo"); en el dashboard se distribuye al promedio individual.
model ConversacionCalificacion {
  id             String   @id @default(cuid())
  conversacionId String
  /// User que da la calificación. Debe ser participante NO-STAFF de la
  /// conversación (validado en la app).
  userId         String
  /// Ciclo de la conversación en el momento de calificar. Permite varias
  /// calificaciones por (conv, user) a lo largo de cierres/reaperturas
  /// sucesivas.
  ciclo          Int
  /// 1-5 estrellas.
  puntaje        Int
  comentario     String?
  createdAt      DateTime @default(now())

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversacionCalificacionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversacionId, userId, ciclo])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("conversacion_calificaciones")
}

model ConversacionParticipante {
  conversacionId String
  userId         String
  rolEnConv      ConversacionParticipanteRol @default(MIEMBRO)
  /// Timestamp del último mensaje que el user marcó como leído. Si es
  /// null o anterior al `ultimoMensajeAt` de la conversación, hay no
  /// leídos. La server action `marcarLeido` lo actualiza al `now()`.
  lastReadAt     DateTime?
  joinedAt       DateTime                    @default(now())

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversacionParticipanteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversacionId, userId])
  @@index([userId])
  @@map("conversacion_participantes")
}

model Mensaje {
  id             String    @id @default(cuid())
  conversacionId String
  autorId        String
  /// Texto del mensaje. Puede ser vacío si el mensaje solo trae adjuntos
  /// (la validación de "contenido O adjuntos" vive en la app).
  contenido      String    @db.Text
  /// Si el autor edita un mensaje, guardamos el timestamp para mostrar
  /// "(editado)" en la UI. El contenido viejo se pierde (no hay historial).
  editadoAt      DateTime?
  /// Soft-delete: el mensaje se marca borrado pero la fila queda para
  /// no corromper la conversación. En la UI se muestra como "Mensaje
  /// borrado". Solo el autor o un ADMIN de la conversación pueden borrar.
  borradoAt      DateTime?
  createdAt      DateTime  @default(now())

  conversacion Conversacion       @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autor        User               @relation("MensajeAutor", fields: [autorId], references: [id], onDelete: Restrict)
  adjuntos     MensajeAdjunto[]
  reacciones   MensajeReaccion[]
  menciones    MensajeMencion[]

  @@index([conversacionId, createdAt])
  @@map("mensajes")
}

/// Sprint Chat · reacciones — un user reacciona a un mensaje con un emoji
/// (set fijo en la app: 👍 ❤️ 😂 🎉 😮 😢). Único por (mensaje, user, emoji)
/// para que cada user pueda alternar varias caritas sobre el mismo mensaje
/// pero no duplicar la misma. Cualquier participante de la conversación
/// puede reaccionar (validación a nivel de app). Si el mensaje está borrado
/// las reacciones quedan en BD pero la UI las oculta.
model MensajeReaccion {
  id        String   @id @default(cuid())
  mensajeId String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  user    User    @relation("MensajeReaccionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mensajeId, userId, emoji])
  @@index([mensajeId])
  @@index([userId])
  @@map("mensaje_reacciones")
}

/// Sprint Chat · menciones — registra que un user fue mencionado (@nombre)
/// en un mensaje. Solo participantes de la conversación pueden ser
/// mencionados (validación en la app). Cada mención dispara una notificación
/// "chat_mencion" en la bandeja del mencionado (sin dedup, sin email).
///
/// Si el mensaje se borra (`borradoAt`), las menciones quedan en BD pero
/// la UI las ignora (al render del mensaje no se muestran chips). Si se
/// edita, el server reemplaza el set completo de menciones.
model MensajeMencion {
  id        String   @id @default(cuid())
  mensajeId String
  userId    String
  createdAt DateTime @default(now())

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  user    User    @relation("MensajeMencionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mensajeId, userId])
  @@index([mensajeId])
  @@index([userId, createdAt])
  @@map("mensaje_menciones")
}

/// Adjuntos del chat — solo imágenes en v1 (jpeg/png/webp/gif). Sigue el
/// mismo patrón que IncapacidadDocumento/SoporteAfDocumento: el binario
/// vive en disco bajo UPLOADS_DIR; la BD guarda el path relativo y los
/// metadatos. La descarga pasa por /api/chat/adjuntos/[id] que chequea
/// que el actor sea participante de la conversación.
model MensajeAdjunto {
  id             String   @id @default(cuid())
  mensajeId      String
  archivoPath    String
  archivoHash    String
  archivoMime    String
  archivoNombre  String
  archivoTamano  Int
  /// Dimensiones opcionales. Si el cliente las envía (extraídas del File
  /// antes de subir) las guardamos para que el thumbnail respete aspect
  /// ratio sin descargar la imagen. Si no, se renderea con tamaño fijo.
  ancho          Int?
  alto           Int?
  /// Soft-delete: análogo a Mensaje.borradoAt. Si está seteado, la
  /// descarga devuelve 410 Gone.
  eliminado      DateTime?
  createdAt      DateTime @default(now())

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@index([mensajeId])
  @@map("mensaje_adjuntos")
}
