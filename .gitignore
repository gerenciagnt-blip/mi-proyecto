# Claude Code — archivos locales, no compartir
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
# Directorio de skills/agents del IDE local (vacío en el repo, se llena
# en cada máquina con su propia config).
.agents/

# n8n-as-code — cache de contexto runtime (se regenera al arrancar).
# La documentación versionada vive en AGENTS.md y .github/agents/.
.n8nac/

# Código legado de Apps Script — ignorar hasta auditar secretos
legacy-appscript/

# Node / pnpm
node_modules/
.pnpm-store/
*.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# Build outputs
dist/
build/

# Uploads de usuarios — no incluir en git (se regeneran en cada entorno)
apps/web/public/uploads/
uploads/

# Variables de entorno (todas, solo se commitea .env.example)
.env
.env.local
.env.*.local

# Prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# Logs y editor
*.log
.DS_Store
.idea/
.vscode/

# Bot Colpatria — artifacts locales (screenshots de debug)
apps/bot-colpatria/test-login.png
apps/bot-colpatria/test-ingreso.png
apps/bot-colpatria/screenshots/
